---
// The Path: the forty-seven lessons as one figure, filled in as they are read. Progress is the
// same localStorage set (`svapna_progress`, keys "module-lesson") the lesson pages write.
import { curriculumModules } from '../lib/content.js';
import { lessonsByModule } from '../lib/lessons.js';

const modules = curriculumModules.map(m => {
  const n = String(parseInt(m.num, 10)), padded = n.padStart(2, '0');
  return { roman: m.roman, title: m.title, href: `/curriculum/module-${padded}`,
    lessons: (lessonsByModule[n] || []).map(l => ({ key: `${l.moduleNum}-${l.lessonNum}`, num: l.lessonNum, title: l.title, kicker: (l.kicker || '').replace(/[*_]/g, ''), href: `/curriculum/module-${padded}/${l.urlSlug}` })) };
});
const total = modules.reduce((n, m) => n + m.lessons.length, 0);
---

<div class="fig path" id="path" data-path={JSON.stringify(modules)}>
  <div class="fig-bar">
    <p class="fig-big"><span id="path-read">0</span><small>of {total} lessons read</small></p>
    <div class="fig-controls">
      <button type="button" id="path-prev" aria-label="Previous lesson">←</button>
      <button type="button" id="path-unread">Next unread ▸</button>
      <button type="button" id="path-next" aria-label="Next lesson">→</button>
    </div>
  </div>
  <div class="path-rows">
    {modules.map((m, mi) => (
      <div class="path-row">
        <a class="fig-label path-mod" href={m.href}>{m.roman} · {m.title}</a>
        <div class="path-cells">
          {m.lessons.map((l, li) => <button type="button" class="path-cell" data-m={mi} data-l={li} data-key={l.key} title={l.title} aria-label={`Module ${m.roman}, lesson ${l.num}: ${l.title}`}></button>)}
        </div>
      </div>
    ))}
  </div>
  <article class="fig-plate" id="path-plate" aria-live="polite">
    <p class="fig-label" id="path-meta"></p>
    <h2 id="path-title"></h2>
    <p class="fig-lede" id="path-kicker"></p>
    <a class="fig-go" id="path-go" href="/curriculum"></a>
  </article>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('path'); if (!root) return;
    var M = JSON.parse(root.dataset.path), flat = [], cur = -1, read = {};
    try { (JSON.parse(localStorage.getItem('svapna_progress') || '[]') || []).forEach(function (k) { read[k] = true; }); } catch (e) {}
    var $ = function (id) { return document.getElementById(id); };
    var cells = Array.prototype.slice.call(root.querySelectorAll('.path-cell'));
    cells.forEach(function (c, i) {
      var m = M[+c.dataset.m], l = m.lessons[+c.dataset.l];
      flat.push({ m: m, l: l, el: c });
      if (read[l.key]) c.classList.add('read');
      c.addEventListener('click', function () { show(i); });
    });
    $('path-read').textContent = flat.filter(function (x) { return read[x.l.key]; }).length;
    function show(i) {
      i = Math.max(0, Math.min(flat.length - 1, i)); if (i === cur) return;
      if (cur >= 0) flat[cur].el.classList.remove('on');
      cur = i; var x = flat[i]; x.el.classList.add('on');
      $('path-meta').textContent = 'Module ' + x.m.roman + ' · ' + x.m.title + ' · Lesson ' + x.l.num + (read[x.l.key] ? ' · Read' : '');
      $('path-title').textContent = x.l.title;
      $('path-kicker').textContent = x.l.kicker; $('path-kicker').hidden = !x.l.kicker;
      var go = $('path-go'); go.href = x.l.href; go.textContent = (read[x.l.key] ? 'Read again' : 'Read the lesson') + ' →';
      var p = $('path-plate'); p.classList.remove('in'); void p.offsetWidth; p.classList.add('in');
    }
    var firstUnread = function (from) { for (var k = 0; k < flat.length; k++) { var i = (from + k) % flat.length; if (!read[flat[i].l.key]) return i; } return 0; };
    $('path-prev').addEventListener('click', function () { show(cur - 1); });
    $('path-next').addEventListener('click', function () { show(cur + 1); });
    $('path-unread').addEventListener('click', function () { show(firstUnread(cur + 1)); });
    root.addEventListener('keydown', function (ev) {
      if (ev.key === 'ArrowRight') { show(cur + 1); ev.preventDefault(); }
      if (ev.key === 'ArrowLeft') { show(cur - 1); ev.preventDefault(); }
    });
    show(firstUnread(0));
  })();
</script>

<style is:global>
  .path-rows { margin-top: 1.5rem; border-top: 0.5px solid #000; }
  .path-row { display: grid; grid-template-columns: 1fr; gap: 0.5rem; padding: 0.8rem 0; border-bottom: 0.5px solid #000; align-items: center; }
  @media (min-width: 768px) { .path-row { grid-template-columns: 16rem 1fr; } }
  .path-mod { color: #000; } .path-mod:hover { font-style: italic; }
  .path-cells { display: flex; flex-wrap: wrap; gap: 6px; }
  .path-cell { width: 26px; height: 26px; padding: 0; border: 1px solid #000; background: #fff; cursor: pointer; position: relative; }
  .path-cell.read { background: #000; }
  .path-cell:hover { background: #d4d4d4; } .path-cell.read:hover { background: #404040; }
  .path-cell.on { outline: 1px solid #000; outline-offset: 3px; }
</style>
