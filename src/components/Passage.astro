---
// One passage, as the question pages show it: the words, who and where, and what can be done with it.
import { slugify } from '../lib/atlas.js';
const { c, note = true } = Astro.props;
const cite = `“${c.excerpt}” — ${c.name}, ${c.work} (${c.dateShort}). ${c.readUrl}`;
---
<article class="row" id={c.id} data-w={(c.translation || c.excerpt).split(/\s+/).length}>
  <div>
    <blockquote lang={c.lang || undefined} translate={c.lang ? 'no' : undefined}>“{c.excerpt}”</blockquote>
    {c.translation && <p class="tr">{c.translation}</p>}
    {note && c.home && <p class="why">From the passages on <a href={`/questions/${c.home.id}#${c.id}`}>{c.home.plain.charAt(0).toLowerCase() + c.home.plain.slice(1)}</a></p>}
  </div>
  <div class="who">
    <a class="name" href={`/thinkers/${slugify(c.name)}#${c.id}`}>{c.name}</a>
    <p>{c.place}</p><p>{c.dateShort}</p><p>{c.work}</p>
    <a class="src" href={c.readUrl} target="_blank" rel="noopener">Read it at the source ↗</a>
    <button class="src quiet say" type="button" data-say={`${c.translation || c.excerpt} ${c.name}.`} hidden>Listen</button>
    <button class="src quiet" type="button" data-copy={cite}>Copy with citation</button>
    <button class="src quiet keep" type="button" data-keep={c.id} data-name={c.name} data-text={c.excerpt} data-href={`/thinkers/${slugify(c.name)}#${c.id}`} data-cite={`${c.work} (${c.dateShort}). ${c.readUrl}`}>Keep this passage</button>
  </div>
</article>
