---
import Fonts from '../components/Fonts.astro';
// The reading layout: the new look for pages meant to be read and found by search.
import { organizationSchema, breadcrumbSchema, buildCrumbs } from '../lib/seo.js';
interface Props { title: string; description: string; path: string; crumbs?: { name: string; path: string }[]; jsonLd?: object | null; image?: string; noindex?: boolean }
const { title, description, path, crumbs = [], jsonLd = null, image = '/og.jpg', noindex = false } = Astro.props;
const siteUrl = 'https://svapnaproject.org/';
const canonical = siteUrl.replace(/\/$/, '') + path;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#05060c" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Svapna" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={siteUrl.replace(/\/$/, '') + image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Svapna" />
<meta name="twitter:image" content={siteUrl.replace(/\/$/, '') + image} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title="Svapna" href="/rss.xml" />
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema(siteUrl))} />
{crumbs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(buildCrumbs(siteUrl, crumbs)))} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<script is:inline>
  (function () { try { if (localStorage.getItem('svapna_type') === 'plain') document.documentElement.dataset.type = 'plain'; } catch (e) {} })();
  (function () { var m = null; try { m = localStorage.getItem('svapna_mode'); } catch (e) {} if (m !== 'light' && m !== 'night') m = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'night'; document.documentElement.dataset.mode = m; var tc = document.querySelector('meta[name=theme-color]'); if (tc) tc.content = m === 'light' ? '#ffffff' : '#05060c'; })();
</script>
<Fonts />
<link rel="stylesheet" href="/read/read.css" />
<script defer src="https://api.pirsch.io/pa.js" id="pianjs" data-code="ZKEB8d2dhWfXicXcGrjg6juT4izbzLaK"></script>
</head>
<body>
<a class="skip" href="#main">Skip to the page</a>
<header class="top">
  <a class="mark" href="/">∴ Svapna</a>
  <nav><a href="/questions">Questions</a><a href="/thinkers">Thinkers</a><a href="/dream">Dreaming</a><a href="/you">You</a><a href="/search" class="wide-only">Search</a><button id="mode" type="button">Mode</button></nav>
</header>
<main id="main" tabindex="-1"><slot /></main>
<footer class="foot">
  <p><a href="/world">The world</a><a href="/questions">Questions</a><a href="/quotes">Quotes</a><a href="/thinkers">Thinkers</a><a href="/circles">Circles</a><a href="/dream">Dreaming</a><a href="/glossary">Glossary</a><a href="/search">Search</a></p>
  <p><a href="/letter">The letter</a><a href="/support">Support Svapna</a><a href="https://www.buymeacoffee.com/svapna" target="_blank" rel="noopener">Buy a coffee ↗</a><a href="/how-it-works">How it works</a><a href="/data">Data</a><a href="/about/privacy">Privacy</a><a href="/about/terms">Terms</a></p>
  <p class="fine">Quotes are checked word for word against the linked source. Where a passage sits on a scale has been read twice, independently, by machine; no human editor has reviewed it yet. <a href="/how-it-works">How it works</a>. Quotes were checked in the language shown; a browser’s translation of them is not the checked text. <button type="button" id="type">Plainer type</button></p>
</footer>
<script is:inline>
  (function () { var b = document.getElementById('mode'), r = document.documentElement; function paint() { b.textContent = r.dataset.mode === 'light' ? 'Night' : 'Light'; }
    b.addEventListener('click', function () { r.dataset.mode = r.dataset.mode === 'light' ? 'night' : 'light'; try { localStorage.setItem('svapna_mode', r.dataset.mode); } catch (e) {} var tc = document.querySelector('meta[name=theme-color]'); if (tc) tc.content = r.dataset.mode === 'light' ? '#ffffff' : '#05060c'; paint(); }); paint(); })();
</script>
<script is:inline>
  // Kept passages and lessons read live on the visitor's own device.
  (function () {
    var get = function (k) { try { return JSON.parse(localStorage.getItem(k) || '[]') || []; } catch (e) { return []; } }, set = function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
    if (location.pathname.indexOf('/curriculum/module-') === 0) { var read = get('svapna_read'), here = location.pathname.replace(/\/$/, ''); if (read.indexOf(here) < 0) { read.push(here); set('svapna_read', read); } }
    // Plainer type: upright, unjoined letters for the quotes, for anyone who reads them more easily that way.
    var tb = document.getElementById('type'), root = document.documentElement; if (tb) { var tp = function () { tb.textContent = root.dataset.type === 'plain' ? 'Original type' : 'Plainer type'; }; tb.addEventListener('click', function () { if (root.dataset.type === 'plain') delete root.dataset.type; else root.dataset.type = 'plain'; try { localStorage.setItem('svapna_type', root.dataset.type || ''); } catch (e) {} tp(); }); tp(); }
    // Listen: the device's own voice reads a passage aloud. The buttons appear only where that is possible.
    if ('speechSynthesis' in window) { document.querySelectorAll('[data-say]').forEach(function (b) { b.hidden = false; }); var saying = null;
      document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-say]'); if (!b) return; speechSynthesis.cancel(); if (saying === b) { saying = null; b.textContent = 'Listen'; return; } if (saying) saying.textContent = 'Listen';
        var u = new SpeechSynthesisUtterance(b.dataset.say); u.lang = 'en'; u.rate = .92; u.onend = function () { if (saying === b) { saying = null; b.textContent = 'Listen'; } }; saying = b; b.textContent = 'Stop'; speechSynthesis.speak(u); }); }
    // Copy a passage with its citation. Rows can be added later (search), so the click is caught on the page.
    document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-copy]'); if (!b) return; var was = b.textContent, done = function (m) { b.textContent = m; setTimeout(function () { b.textContent = was; }, 2200); };
      if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.copy).then(function () { done('Copied'); }, function () { done('Could not copy'); }); else done('Could not copy'); });
    // Save a passage as an image, with its attribution, for sharing or printing. Drawn here on the device.
    function addCard(b) { if (b.nextElementSibling && b.nextElementSibling.dataset.card) return; var s = document.createElement('button'); s.type = 'button'; s.className = 'src quiet'; s.textContent = 'Save as image'; s.dataset.card = '1'; b.after(s); }
    document.querySelectorAll('.who [data-copy]').forEach(addCard); window.svapnaCard = addCard;
    function wrap(x, text, max) { var out = [], line = ''; text.split(/\s+/).forEach(function (w) { var t = line ? line + ' ' + w : w; if (x.measureText(t).width > max && line) { out.push(line); line = w; } else line = t; }); if (line) out.push(line); return out; }
    document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-card]'); if (!b) return; var row = b.closest('.row, article') || document, cp = row.querySelector('[data-copy]'); if (!cp) return;
      var m = /^“([\s\S]*)” — ([\s\S]*?)\. https?:\S+$/.exec(cp.dataset.copy) || [null, cp.dataset.copy, ''], tr = row.querySelector('.tr'), quote = (tr ? tr.textContent : m[1]).trim(), by = m[2], was = b.textContent; b.textContent = 'Making it…';
      var fonts = document.fonts ? Promise.all([document.fonts.load("italic 400 60px 'Instrument Serif'"), document.fonts.load("600 34px 'Inter Tight'")]) : Promise.resolve();
      fonts.catch(function () {}).then(function () {
        var W = 1080, H = 1350, c = document.createElement('canvas'); c.width = W; c.height = H; var x = c.getContext('2d');
        x.fillStyle = '#05060c'; x.fillRect(0, 0, W, H);
        var g = x.createRadialGradient(880, 180, 0, 880, 180, 760); g.addColorStop(0, 'rgba(111,143,255,.34)'); g.addColorStop(.5, 'rgba(39,211,168,.14)'); g.addColorStop(1, 'rgba(5,6,12,0)'); x.fillStyle = g; x.fillRect(0, 0, W, H);
        x.fillStyle = '#f4f4f8'; x.textBaseline = 'top'; x.font = "600 30px 'Inter Tight', sans-serif"; x.fillText('∴ Svapna', 84, 84);
        var size = 72, lines; do { x.font = 'italic 400 ' + size + "px 'Instrument Serif', Georgia, serif"; lines = wrap(x, '“' + quote + '”', W - 168); size -= 4; } while (lines.length * (size + 4) * 1.16 > 760 && size > 26); size += 4;
        var lh = size * 1.16, y = 210 + Math.max(0, (760 - lines.length * lh) / 2); lines.forEach(function (l) { x.fillText(l, 84, y); y += lh; });
        x.font = "600 34px 'Inter Tight', sans-serif"; var who = wrap(x, by, W - 168), yy = 1040; x.fillText(who[0] || '', 84, yy); yy += 46;
        x.fillStyle = 'rgba(244,244,248,.66)'; x.font = "500 25px 'Inter Tight', sans-serif"; who.slice(1, 3).forEach(function (l) { x.fillText(l, 84, yy); yy += 36; });
        x.fillStyle = 'rgba(244,244,248,.5)'; x.font = "500 23px 'Inter Tight', sans-serif"; x.fillText('Checked word for word against its source · svapnaproject.org', 84, H - 110);
        c.toBlob(function (blob) { b.textContent = was; if (!blob) return; var name = 'svapna-' + (row.id || 'passage') + '.jpg', file; try { file = new File([blob], name, { type: 'image/jpeg' }); } catch (err) {}
          if (window.pirsch) { try { window.pirsch('card_saved'); } catch (err) {} }
          if (file && navigator.canShare && navigator.canShare({ files: [file] })) { navigator.share({ files: [file] }).catch(function () {}); return; }
          var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 2000); }, 'image/jpeg', .92);
      }); });
    var btns = document.querySelectorAll('[data-keep]'); if (!btns.length) return;
    function paint() { var kept = get('svapna_kept').map(function (x) { return x.id; }); btns.forEach(function (b) { var on = kept.indexOf(b.dataset.keep) >= 0; b.textContent = on ? 'Kept · see your list' : 'Keep this passage'; b.dataset.on = on ? '1' : ''; }); }
    btns.forEach(function (b) { b.addEventListener('click', function () { if (b.dataset.on) { location.href = '/you#kept'; return; } var kept = get('svapna_kept'); kept.unshift({ id: b.dataset.keep, name: b.dataset.name, text: b.dataset.text, href: b.dataset.href, cite: b.dataset.cite || '' }); set('svapna_kept', kept.slice(0, 200)); paint(); }); });
    paint();
  })();
</script>
</body>
</html>
