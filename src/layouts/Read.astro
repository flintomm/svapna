---
import Fonts from '../components/Fonts.astro';
// The reading layout: the new look for pages meant to be read and found by search.
import { organizationSchema, breadcrumbSchema, buildCrumbs } from '../lib/seo.js';
interface Props { title: string; description: string; path: string; crumbs?: { name: string; path: string }[]; jsonLd?: object | null; image?: string; noindex?: boolean }
const { title, description, path, crumbs = [], jsonLd = null, image = '/og.jpg', noindex = false } = Astro.props;
const siteUrl = 'https://svapnaproject.org/';
const canonical = siteUrl.replace(/\/$/, '') + path;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#05060c" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Svapna" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={siteUrl.replace(/\/$/, '') + image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Svapna" />
<meta name="twitter:image" content={siteUrl.replace(/\/$/, '') + image} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title="Svapna" href="/rss.xml" />
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema(siteUrl))} />
{crumbs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(buildCrumbs(siteUrl, crumbs)))} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<script is:inline>
  (function () { try { if (localStorage.getItem('svapna_type') === 'plain') document.documentElement.dataset.type = 'plain'; } catch (e) {} })();
  (function () { try { if (localStorage.getItem('svapna_big') === '1') document.documentElement.dataset.big = '1'; } catch (e) {} })();
  (function () { var m = null; try { m = localStorage.getItem('svapna_mode'); } catch (e) {} if (m !== 'light' && m !== 'night') m = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'night'; document.documentElement.dataset.mode = m; var tc = document.querySelector('meta[name=theme-color]'); if (tc) tc.content = m === 'light' ? '#ffffff' : '#05060c'; })();
</script>
<Fonts />
<link rel="stylesheet" href="/read/read.css" />
<script defer src="https://api.pirsch.io/pa.js" id="pianjs" data-code="ZKEB8d2dhWfXicXcGrjg6juT4izbzLaK"></script>
</head>
<body>
<a class="skip" href="#main">Skip to the page</a>
<header class="top">
  <a class="mark" href="/">∴ Svapna</a>
  <nav><a href="/questions">Questions</a><a href="/thinkers">Thinkers</a><a href="/dream">Dreaming</a><a href="/you">You</a><a href="/search" class="wide-only">Search</a><button id="big-top" type="button" aria-label="A+ larger text" title="Larger text">A+</button><button id="mode" type="button">Mode</button></nav>
</header>
<main id="main" tabindex="-1"><slot /></main>
<footer class="foot">
  <p><a href="/world">The world</a><a href="/questions">Questions</a><a href="/quotes">Quotes</a><a href="/thinkers">Thinkers</a><a href="/circles">Circles</a><a href="/dream">Dreaming</a><a href="/glossary">Glossary</a><a href="/search">Search</a></p>
  <p><a href="/letter">The letter</a><a href="/support">Support Svapna</a><a href="https://www.buymeacoffee.com/svapna" target="_blank" rel="noopener">Buy a coffee ↗</a><a href="/how-it-works">How it works</a><a href="/data">Data</a><a href="/about/privacy">Privacy</a><a href="/about/terms">Terms</a></p>
  <p class="fine">Quotes are checked word for word against the linked source. Where a passage sits on a scale has been read twice, independently, by machine; no human editor has reviewed it yet. <a href="/how-it-works">How it works</a>. Quotes were checked in the language shown; a browser’s translation of them is not the checked text. <button type="button" id="type">Plainer type</button> <button type="button" id="big">Larger text</button></p>
</footer>
<script is:inline>
  (function () { var b = document.getElementById('mode'), r = document.documentElement; function paint() { b.textContent = r.dataset.mode === 'light' ? 'Night' : 'Light'; }
    b.addEventListener('click', function () { r.dataset.mode = r.dataset.mode === 'light' ? 'night' : 'light'; try { localStorage.setItem('svapna_mode', r.dataset.mode); } catch (e) {} var tc = document.querySelector('meta[name=theme-color]'); if (tc) tc.content = r.dataset.mode === 'light' ? '#ffffff' : '#05060c'; paint(); }); paint(); })();
</script>
<script is:inline>
  // Kept passages and lessons read live on the visitor's own device.
  (function () {
    var get = function (k) { try { return JSON.parse(localStorage.getItem(k) || '[]') || []; } catch (e) { return []; } }, set = function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
    if (location.pathname.indexOf('/curriculum/module-') === 0) { var read = get('svapna_read'), here = location.pathname.replace(/\/$/, ''); if (read.indexOf(here) < 0) { read.push(here); set('svapna_read', read); } }
    // Plainer type: upright, unjoined letters for the quotes, for anyone who reads them more easily that way.
    var bb = document.getElementById('big'), bt = document.getElementById('big-top'); if (bb) { var bp = function () { var on = !!document.documentElement.dataset.big; bb.textContent = on ? 'Normal text' : 'Larger text'; if (bt) { bt.textContent = on ? 'A−' : 'A+'; bt.setAttribute('aria-label', on ? 'A− normal text' : 'A+ larger text'); bt.title = on ? 'Normal text' : 'Larger text'; } }; if (bt) bt.addEventListener('click', function () { bb.click(); }); bb.addEventListener('click', function () { var r = document.documentElement; if (r.dataset.big) delete r.dataset.big; else r.dataset.big = '1'; try { localStorage.setItem('svapna_big', r.dataset.big ? '1' : '0'); } catch (e) {} bp(); }); bp(); }
    var tb = document.getElementById('type'), root = document.documentElement; if (tb) { var tp = function () { tb.textContent = root.dataset.type === 'plain' ? 'Original type' : 'Plainer type'; }; tb.addEventListener('click', function () { if (root.dataset.type === 'plain') delete root.dataset.type; else root.dataset.type = 'plain'; try { localStorage.setItem('svapna_type', root.dataset.type || ''); } catch (e) {} tp(); }); tp(); }
    // Listen: the device's own voice reads a passage aloud. The buttons appear only where that is possible.
    if ('speechSynthesis' in window) { document.querySelectorAll('[data-say]').forEach(function (b) { b.hidden = false; }); var saying = null;
      document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-say]'); if (!b) return; speechSynthesis.cancel(); if (saying === b) { saying = null; b.textContent = 'Listen'; return; } if (saying) saying.textContent = 'Listen';
        var u = new SpeechSynthesisUtterance(b.dataset.say); u.lang = 'en'; u.rate = .92; u.onend = function () { if (saying === b) { saying = null; b.textContent = 'Listen'; } }; saying = b; b.textContent = 'Stop'; speechSynthesis.speak(u); }); }
    // Copy a passage with its citation. Rows can be added later (search), so the click is caught on the page.
    document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-copy]'); if (!b) return; var was = b.textContent, done = function (m) { b.textContent = m; setTimeout(function () { b.textContent = was; }, 2200); };
      if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.copy).then(function () { done('Copied'); }, function () { done('Could not copy'); }); else done('Could not copy'); });
    // After a copy, offer the same citation in the two formats most often asked for.
    var mla = null;
    function parts(row, cp) { var m = /^“([\s\S]*)” — ([\s\S]*?)\. (https?:\S+)$/.exec(cp.dataset.copy); if (!m) return null; var nm = row.querySelector('.name'), h = document.querySelector('h1'), name = nm ? nm.textContent.trim() : (h && m[2].indexOf(h.textContent.trim()) === 0 ? h.textContent.trim() : ''); if (!name || m[2].indexOf(name) !== 0) return null; var rest = m[2].slice(name.length).replace(/^,\s*/, ''), d = /\s*\(([^()]*)\)$/.exec(rest); var work = d ? rest.slice(0, d.index) : rest; return { quote: m[1], name: name, own: work.toLowerCase().indexOf(name.replace(/^the /i, '').toLowerCase()) === 0, work: work, date: d ? d[1] : '', url: m[3] }; }
    function put(b, text) { var was = b.textContent; if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = was; }, 2000); }, function () {}); }
    document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-copy]'); if (!b || b.dataset.fmt) return; var row = b.closest('.row, article'); if (!row || !parts(row, b)) return; b.dataset.fmt = '1';
      ['Chicago', 'MLA'].forEach(function (f) { var x = document.createElement('button'); x.type = 'button'; x.className = 'src quiet'; x.textContent = f; x.dataset.style = f; b.after(x); }); });
    document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-style]'); if (!b) return; var row = b.closest('.row, article'), p = parts(row, row.querySelector('[data-copy]')); if (!p) return;
      if (b.dataset.style === 'Chicago') { put(b, (p.own ? '' : p.name + ', ') + p.work + (p.date ? ' (' + p.date + ')' : '') + ', ' + p.url + '.'); return; }
      var go = function () { var who = (mla && mla[p.name]) || p.name, t = new Date(), mon = ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May', 'June', 'July', 'Aug.', 'Sept.', 'Oct.', 'Nov.', 'Dec.'][t.getMonth()]; put(b, (p.own ? '' : who + (/\.$/.test(who) ? ' ' : '. ')) + p.work + '. ' + (p.date ? p.date.replace(/^c\. /, 'c. ') + '. ' : '') + p.url + '. Accessed ' + t.getDate() + ' ' + mon + ' ' + t.getFullYear() + '.'); };
      if (mla) go(); else fetch('/data/cite.json').then(function (r) { return r.json(); }).then(function (d) { mla = d; go(); }, function () { mla = {}; go(); }); });
    // Save a passage as an image, with its attribution, for sharing or printing. Drawn here on the device.
    function addCard(b) { if (b.nextElementSibling && b.nextElementSibling.dataset.card) return; var s = document.createElement('button'); s.type = 'button'; s.className = 'src quiet'; s.textContent = 'Save as image'; s.dataset.card = '1'; b.after(s); }
    document.querySelectorAll('.who [data-copy]').forEach(addCard); window.svapnaCard = addCard;
    function wrap(x, text, max) { var out = [], line = ''; text.split(/\s+/).forEach(function (w) { var t = line ? line + ' ' + w : w; if (x.measureText(t).width > max && line) { out.push(line); line = w; } else line = t; }); if (line) out.push(line); return out; }
    document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-card]'); if (!b) return;
      if (b.dataset.card === '1') { // first tap: offer the two shapes
        var sq = document.createElement('button'); sq.type = 'button'; sq.className = 'src quiet'; sq.textContent = 'Square'; sq.dataset.card = 'square'; b.textContent = 'Tall'; b.dataset.card = 'tall'; b.after(sq); var lab = document.createElement('span'); lab.className = 'src quiet card-as'; lab.textContent = 'Image:'; b.before(lab); return; }
      var square = b.dataset.card === 'square', light = document.documentElement.dataset.mode === 'light';
      var row = b.closest('.row, article') || document, cp = row.querySelector('[data-copy]'); if (!cp) return;
      var m = /^“([\s\S]*)” — ([\s\S]*?)\. https?:\S+$/.exec(cp.dataset.copy) || [null, cp.dataset.copy, ''], tr = row.querySelector('.tr'), quote = (tr ? tr.textContent : m[1]).trim(), by = m[2], was = b.textContent; b.textContent = '…';
      var fonts = document.fonts ? Promise.all([document.fonts.load("italic 400 60px 'Instrument Serif'"), document.fonts.load("600 34px 'Inter Tight'")]) : Promise.resolve();
      fonts.catch(function () {}).then(function () {
        var W = 1080, H = square ? 1080 : 1350, room = square ? 560 : 760, ink = light ? '10,10,14' : '244,244,248', c = document.createElement('canvas'); c.width = W; c.height = H; var x = c.getContext('2d');
        x.fillStyle = light ? '#f7f6f2' : '#05060c'; x.fillRect(0, 0, W, H);
        var g = x.createRadialGradient(880, 180, 0, 880, 180, 760); g.addColorStop(0, light ? 'rgba(111,143,255,.30)' : 'rgba(111,143,255,.34)'); g.addColorStop(.5, light ? 'rgba(39,211,168,.12)' : 'rgba(39,211,168,.14)'); g.addColorStop(1, light ? 'rgba(247,246,242,0)' : 'rgba(5,6,12,0)'); x.fillStyle = g; x.fillRect(0, 0, W, H);
        x.fillStyle = 'rgb(' + ink + ')'; x.textBaseline = 'top'; x.font = "600 30px 'Inter Tight', sans-serif"; x.fillText('∴ Svapna', 84, 84);
        var size = 72, lines; do { x.font = 'italic 400 ' + size + "px 'Instrument Serif', Georgia, serif"; lines = wrap(x, '“' + quote + '”', W - 168); size -= 4; } while (lines.length * (size + 4) * 1.16 > room && size > 24); size += 4;
        var lh = size * 1.16, y = (square ? 170 : 210) + Math.max(0, (room - lines.length * lh) / 2); lines.forEach(function (l) { x.fillText(l, 84, y); y += lh; });
        var nm = row.querySelector('.name'), name = nm ? nm.textContent.trim() : (by.indexOf(document.querySelector('h1').textContent.trim()) === 0 ? document.querySelector('h1').textContent.trim() : ''), rest = name && by.indexOf(name) === 0 ? by.slice(name.length).replace(/^,\s*/, '') : '';
        if (!name) { name = by; rest = ''; }
        x.font = "600 34px 'Inter Tight', sans-serif"; var yy = H - 340; wrap(x, name, W - 168).slice(0, 2).forEach(function (l) { x.fillText(l, 84, yy); yy += 44; });
        x.fillStyle = 'rgba(' + ink + ',.66)'; x.font = "500 25px 'Inter Tight', sans-serif"; yy += 6; wrap(x, rest, W - 168).slice(0, square ? 2 : 3).forEach(function (l) { x.fillText(l, 84, yy); yy += 35; });
        x.fillStyle = 'rgba(' + ink + ',.5)'; x.font = "500 23px 'Inter Tight', sans-serif"; x.fillText('Checked word for word against its source · svapnaproject.org', 84, H - 110);
        c.toBlob(function (blob) { b.textContent = was; if (!blob) return; var name = 'svapna-' + (row.id || 'passage') + '.jpg', file; try { file = new File([blob], name, { type: 'image/jpeg' }); } catch (err) {}
          if (window.pirsch) { try { window.pirsch('card_saved'); } catch (err) {} }
          if (file && navigator.canShare && navigator.canShare({ files: [file] })) { navigator.share({ files: [file] }).catch(function () {}); return; }
          var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 2000); }, 'image/jpeg', .92);
      }); });
    var btns = document.querySelectorAll('[data-keep]'); if (!btns.length) return;
    function paint() { var kept = get('svapna_kept').map(function (x) { return x.id; }); btns.forEach(function (b) { var on = kept.indexOf(b.dataset.keep) >= 0; b.textContent = on ? 'Kept · see your list' : 'Keep this passage'; b.dataset.on = on ? '1' : ''; }); }
    btns.forEach(function (b) { b.addEventListener('click', function () { if (b.dataset.on) { location.href = '/you#kept'; return; } var kept = get('svapna_kept'); kept.unshift({ id: b.dataset.keep, name: b.dataset.name, text: b.dataset.text, href: b.dataset.href, cite: b.dataset.cite || '' }); set('svapna_kept', kept.slice(0, 200)); paint(); }); });
    paint();
  })();
</script>
</body>
</html>
