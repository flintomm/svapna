---
import '../styles/global.css';
import { organizationSchema, websiteSchema } from '../lib/seo.js';
import { allLetters } from '../lib/letters.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object | object[];
}

const {
  title = 'Svapna Project - Dream Yoga & Lucid Dreaming',
  description = 'The work, drawing on Mandukya, Tibetan milam, and modern lucid-dreaming science. History, practice, community.',
  ogImage = '/og.jpg',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') + '/' : 'https://svapnaproject.org/';
const canonical = new URL(Astro.url.pathname, siteUrl).href.replace(/\/$/, '') || siteUrl;
const ogImageAbs = new URL(ogImage, siteUrl).href;
// Twitter card image follows ogImage when overridden; falls back to the
// site-wide /twitter-card.jpg only when the default ogImage is in use, so
// the 2:1 Twitter canvas can still ship for the home page while per-page
// 1.91:1 OG cards (e.g. the Door variants) reach the Twitter validator too.
const twitterImageAbs = ogImage === '/og.jpg'
  ? new URL('/twitter-card.jpg', siteUrl).href
  : ogImageAbs;

// Site-wide schema is always emitted; per-page schemas are appended.
const allSchemas = [organizationSchema(siteUrl), websiteSchema(siteUrl)];
if (Array.isArray(jsonLd)) {
  for (const s of jsonLd) if (s) allSchemas.push(s);
} else if (jsonLd) {
  allSchemas.push(jsonLd);
}

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/', label: 'Home', num: '01' },
  { href: '/history', label: 'History', num: '02' },
  { href: '/curriculum', label: 'Curriculum', num: '03' },
  { href: '/community', label: 'Community', num: '04' },
  { href: '/library', label: 'Library', num: '05' },
  { href: '/support', label: 'Support', num: '06' },
  { href: '/globe-of-thought', label: 'Globe', num: '07' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}

// Latest published item shown in the footer strip. Lessons carry no dates,
// so newsletter letters are the canonical "most recent" source. `allLetters`
// is sorted newest-first; if the letters folder is empty the strip is
// omitted entirely.
const latestLetter = allLetters[0] || null;
const latestPublished = latestLetter
  ? {
      title: latestLetter.title,
      date: latestLetter.displayDate,
      href: `/letter/${latestLetter.slug}`,
      label: 'Letter',
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Svapna" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageAbs} />
    <link rel="alternate" type="application/rss+xml" title="Svapna" href="/rss.xml" />
    {allSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="ce803793-d5c7-4cef-9e9e-bf173d3bc6e1" data-domains="svapnaproject.org"></script>
    <script is:inline>
      (function () { var m = null; try { m = localStorage.getItem('svapna_mode'); } catch (e) {} if (m !== 'light' && m !== 'night') m = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'night'; document.documentElement.dataset.mode = m; })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/read/read.css" />
    <link rel="stylesheet" href="/read/reskin.css" />
  </head>
  <body class="reskin">
    <header class="top">
      <a class="mark" href="/">∴ Svapna</a>
      <nav><a href="/questions">Questions</a><a href="/thinkers">Thinkers</a><a href="/dream">Dreaming</a><a href="/library">Library</a><a href="/you">You</a><button id="mode" type="button">Mode</button></nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <p><a href="/">The world</a><a href="/questions">Questions</a><a href="/thinkers">Thinkers</a><a href="/circles">Circles</a><a href="/dream">Dreaming</a><a href="/library">Library</a><a href="/glossary">Glossary</a><a href="/letter">Letters</a></p>
      <p><a href="/support">Support Svapna</a><a href="https://www.buymeacoffee.com/svapna" target="_blank" rel="noopener" data-umami-event="coffee_click">Buy a coffee ↗</a><a href="/about/acknowledgments">Acknowledgments</a><a href="/about/disclaimer">Medical disclaimer</a><a href="/about/contact">Contact</a><a href="/about/privacy">Privacy</a><a href="/about/terms">Terms</a><a href="/rss.xml">RSS</a></p>
      {latestPublished && <p class="fine">Latest letter: <a href={latestPublished.href}>{latestPublished.title}</a>, {latestPublished.date}</p>}
    </footer>

    <script is:inline>
      (function () { var b = document.getElementById('mode'), r = document.documentElement; function paint() { b.textContent = r.dataset.mode === 'light' ? 'Night' : 'Light'; }
        b.addEventListener('click', function () { r.dataset.mode = r.dataset.mode === 'light' ? 'night' : 'light'; try { localStorage.setItem('svapna_mode', r.dataset.mode); } catch (e) {} paint(); }); paint(); })();
    </script>

    <script is:inline>
      // Site-wide Umami helper. Tolerates the loader being absent (blocked,
      // offline, or still pending) so call sites never need to guard the call.
      window.trackUmami = function (name) {
        try {
          if (window.umami && typeof window.umami.track === 'function') {
            window.umami.track(name);
          }
        } catch (e) {
          /* swallow — analytics must never break a page */
        }
      };
    </script>

  </body>
</html>
