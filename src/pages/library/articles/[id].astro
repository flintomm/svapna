---
import Read from '../../../layouts/Read.astro';
import Coffee from '../../../components/Coffee.astro';
import InlineMarkdown from '../../../components/InlineMarkdown.astro';
import { articles } from '../../../lib/content.js';
import { articleSchema } from '../../../lib/seo.js';
import articlesData from '../../../data/articles.json';
export function getStaticPaths() { return articles.map(meta => ({ params: { id: meta.id }, props: { meta, article: (articlesData.articles || []).find(a => a.id === meta.id) || null } })); }
const { meta, article } = Astro.props;
const idx = articles.findIndex(a => a.id === meta.id), prev = idx > 0 ? articles[idx - 1] : null, next = idx < articles.length - 1 ? articles[idx + 1] : null;
const path = `/library/articles/${meta.id}`;
const jsonLd = articleSchema({ url: 'https://svapnaproject.org' + path, headline: `${meta.label}: ${meta.title}`, description: meta.blurb, section: 'Library' });
const blocks = article ? article.blocks : [];
---
<Read title={`${meta.label}: ${meta.title} — Svapna`} description={meta.blurb.slice(0, 180)} path={path} crumbs={[{ name: 'Library', path: '/library' }, { name: meta.label, path }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a> · <a href="/library">Library</a> · Essay {meta.num} of {articles.length} · {Math.round(meta.word_count / 230)} min</p>
  <h1 class="h-read">{meta.label}</h1>
  <p class="lede">{meta.blurb}</p>
  <div class="prose">
    {blocks.map(b => b.kind === 'rule' ? <hr /> : b.kind === 'h2' ? <h2><InlineMarkdown text={b.text} /></h2> : b.kind === 'h3' ? <h3><InlineMarkdown text={b.text} /></h3>
      : b.kind === 'quote' ? <blockquote><p><InlineMarkdown text={b.text} /></p></blockquote>
      : b.kind === 'list' ? <ul>{(b.items || []).map(i => <li><InlineMarkdown text={i} /></li>)}</ul> : <p><InlineMarkdown text={b.text} /></p>)}
  </div>
  <nav class="turn">
    {prev ? <a href={`/library/articles/${prev.id}`}><span class="small">Before</span>{prev.label}</a> : <span></span>}
    {next ? <a class="r" href={`/library/articles/${next.id}`}><span class="small">Next</span>{next.label}</a> : <span></span>}
  </nav>
  <Coffee line="If this essay was worth reading, a coffee keeps Svapna open." />
</Read>
