---
import Read from '../../layouts/Read.astro';
import Coffee from '../../components/Coffee.astro';
import { articles, library, themes } from '../../lib/content.js';
import quotesData from '../../data/quotes.json';
const types = [...new Set(library.map(b => b.type))];
---
<Read title="The library: essays, themes, voices and sources on dreaming — Svapna" description={`Six long essays on the traditions of dream practice, ${themes.length} themes traced through the primary texts, ${quotesData.quotes.length} voices and the ${library.length} sources behind the work.`} path="/library" crumbs={[{ name: 'Library', path: '/library' }]}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a> · Library</p>
  <h1>The <em>library.</em></h1>
  <p class="lede">What stands behind Dreaming: six long essays, {themes.length} themes traced through the primary texts, {quotesData.quotes.length} voices, and the sources themselves.</p>

  <section id="essays">
    <h2>Six essays</h2>
    <p class="def">One for each tradition and era, from the Upaniṣads to the sleep laboratory. Long reads, with their citations.</p>
    <div class="qlist">
      {articles.map(a => <a href={`/library/articles/${a.id}`}><span><b class="circle-name">{a.label}</b><i class="circle-line">{a.blurb}</i></span><span>{Math.round(a.word_count / 230)} min</span></a>)}
    </div>
  </section>

  <section id="themes">
    <h2>{themes.length} themes</h2>
    <p class="def">Concerns that recur across the texts, each gathered with the passages where it appears.</p>
    <div class="index">{themes.map(t => <a href={`/library/themes/${t.id}`}>{t.label}<span>{t.sources} sources</span></a>)}</div>
  </section>

  <section id="voices">
    <h2>{quotesData.quotes.length} voices</h2>
    <div class="rows">
      {quotesData.quotes.map(q => (
        <article class="row">
          <div><blockquote>“{q.text}”</blockquote><p class="why">{q.context}</p></div>
          <div class="who"><p class="name-plain">{q.attribution}</p><p>{q.citation}</p><p>{q.tradition}</p>{q.translator && q.translator !== 'Various' && <p>{q.translator}</p>}</div>
        </article>
      ))}
    </div>
  </section>

  <section id="sources">
    <h2>The sources</h2>
    {types.map(type => (
      <>
        <p class="small" style="margin-top:38px">{type}</p>
        <div class="rows" style="margin-top:10px">
          {library.filter(b => b.type === type).map(b => (
            <article class="row term">
              <div><p class="src-title">{b.title}</p><p class="small">{b.author}{b.year ? ` · ${b.year}` : ''}</p></div>
              <div><p class="term-def">{b.summary}</p>{b.reference && <p class="small" style="margin-top:8px">{b.reference}</p>}</div>
            </article>
          ))}
        </div>
      </>
    ))}
  </section>
  <Coffee />
</Read>
