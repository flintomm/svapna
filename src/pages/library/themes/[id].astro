---
import Read from '../../../layouts/Read.astro';
import Coffee from '../../../components/Coffee.astro';
import { themes } from '../../../lib/content.js';
import themedPassages from '../../../data/themed_passages.json';
export function getStaticPaths() { return themes.map(t => ({ params: { id: t.id }, props: { theme: t, data: themedPassages[t.id] || null } })); }
const { theme, data } = Astro.props;
const clean = s => s.replace(/[*_#>`]+/g, '').replace(/\s+/g, ' ').trim();
// One block per text, however many of its sections the theme touches.
const by = new Map();
for (const e of (data ? data.entries : [])) { if (!by.has(e.source_title)) by.set(e.source_title, { title: e.source_title, tradition: e.tradition, passages: [] }); by.get(e.source_title).passages.push(...e.passages); }
const sources = [...by.values()].sort((a, b) => b.passages.length - a.passages.length);
const total = sources.reduce((n, s) => n + s.passages.length, 0);
const idx = themes.findIndex(t => t.id === theme.id), prev = idx > 0 ? themes[idx - 1] : null, next = idx < themes.length - 1 ? themes[idx + 1] : null;
---
<Read title={`${theme.label}: ${total} passages across the texts — Svapna`} description={`${theme.desc} ${total} passages from ${sources.length} texts.`.slice(0, 180)} path={`/library/themes/${theme.id}`} crumbs={[{ name: 'Library', path: '/library' }, { name: theme.label, path: `/library/themes/${theme.id}` }]}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a> · <a href="/library#themes">Themes</a></p>
  <h1 class="h-read">{theme.label}</h1>
  <p class="lede">{theme.desc}</p>
  <p class="small" style="margin-top:22px">{total} passages in {sources.length} texts. Each is a short stretch of the text around a matching word, as an index gives it, not an edited quotation.</p>
  {sources.map(s => (
    <section>
      <h2 class="h-src">{s.title}</h2>
      <p class="def">{s.tradition} · {s.passages.length} {s.passages.length === 1 ? 'passage' : 'passages'}</p>
      <div class="rows">
        {s.passages.slice(0, 12).map(p => <article class="row snippet"><p>… {clean(p.snippet)} …</p><p class="small">{p.keyword}</p></article>)}
      </div>
      {s.passages.length > 12 && <p class="small" style="margin-top:14px">And {s.passages.length - 12} more in this text.</p>}
    </section>
  ))}
  <nav class="turn">
    {prev ? <a href={`/library/themes/${prev.id}`}><span class="small">Before</span>{prev.label}</a> : <span></span>}
    {next ? <a class="r" href={`/library/themes/${next.id}`}><span class="small">Next</span>{next.label}</a> : <span></span>}
  </nav>
  <Coffee />
</Read>
