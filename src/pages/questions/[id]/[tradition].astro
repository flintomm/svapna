---
// One question as answered within one tradition: every passage the atlas holds, grouped by answer.
import Read from '../../../layouts/Read.astro';
import Coffee from '../../../components/Coffee.astro';
import { slugify, SECOND, TOPIC, TRAD, tradSets } from '../../../lib/atlas.js';
export function getStaticPaths() { return tradSets.map(x => ({ params: { id: x.q.id, tradition: x.slug }, props: { x } })); }
const { x } = Astro.props, q = x.q, [who, one] = TRAD[x.t], topic = TOPIC[q.id];
const scored = q.steps.filter(s => s.tone !== 'none'), count = s => x.placed.filter(c => c.score === s.id).length;
const names = [...new Set(x.placed.map(c => c.name))], others = tradSets.filter(y => y.q.id === q.id && y.t !== x.t), elsewhere = tradSets.filter(y => y.t === x.t && y.q.id !== q.id);
const title = `What ${who} ${one ? 'says' : 'say'} about ${topic}: ${x.placed.length} passages with sources — Svapna`;
const desc = `${q.plain} ${x.placed.length} passages from ${names.slice(0, 4).join(', ')}${names.length > 4 ? ' and others' : ''}, each quoted from its source and placed by its own words: ${scored.filter(s => count(s)).map(s => `${count(s)} “${s.plain.toLowerCase()}”`).join(', ')}.`;
const path = `/questions/${q.id}/${x.slug}`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title.replace(' — Svapna', ''), description: desc, url: 'https://svapnaproject.org' + path,
  mainEntity: { '@type': 'ItemList', numberOfItems: x.placed.length, itemListElement: x.placed.slice(0, 25).map((c, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Quotation', text: c.excerpt, creator: { '@type': 'Thing', name: c.name }, url: `https://svapnaproject.org/thinkers/${slugify(c.name)}#${c.id}` } })) } };
---
<Read title={title} description={desc} path={path} image={`/og/q-${q.id}.jpg`} crumbs={[{ name: 'Questions', path: '/questions' }, { name: q.plain, path: `/questions/${q.id}` }, { name: x.t, path }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/questions">Questions</a> · <a href={`/questions/${q.id}`}>{q.plain}</a></p>
  <h1>What {who} {one ? 'says' : 'say'} <em>about {topic}.</em></h1>
  <p class="lede">{x.placed.length} passages from {names.length} {names.length === 1 ? 'voice' : 'voices'} in {x.t.toLowerCase().startsWith('the ') ? x.t : x.t}, from {x.placed[0].dateShort} to {x.placed.at(-1).dateShort}, on the question: {q.plain.charAt(0).toLowerCase() + q.plain.slice(1)} Each is quoted from a named source and placed by what its own words say.</p>
  <div class="tally" aria-hidden="true">{q.steps.map(s => count(s) > 0 && <i style={`flex:${count(s)};background:var(--${s.tone})`}></i>)}</div>
  <p class="keys">{q.steps.map(s => count(s) > 0 && <a href={`#${s.id}`}><span class="dot" style={`--c:var(--${s.tone})`}></span><b>{count(s)}</b> {s.plain.toLowerCase()}</a>)}</p>
  {q.steps.map(s => count(s) > 0 && (
    <section id={s.id}>
      <h2><span class="dot" style={`--c:var(--${s.tone})`}></span>{s.plain}</h2>
      <p class="def">{s.definition}</p>
      <div class="rows">
        {x.placed.filter(c => c.score === s.id).map(c => (
          <article class="row">
            <div>
              <blockquote lang={c.lang || undefined} translate={c.lang ? 'no' : undefined}>“{c.excerpt}”</blockquote>
              {c.translation && <p class="tr">{c.translation}</p>}
              <p class="why">{c.why}</p>
              {SECOND[c.second] && <p class={`twice ${c.second}`}>{SECOND[c.second]}</p>}
            </div>
            <div class="who">
              <a class="name" href={`/thinkers/${slugify(c.name)}#${c.id}`}>{c.name}</a>
              <p>{c.place}</p><p>{c.dateShort}</p><p>{c.work}</p>
              <a class="src" href={c.readUrl} target="_blank" rel="noopener">Read it at the source ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
  <section>
    <h2 class="h-src">The same question, other traditions</h2>
    <div class="index" style="margin-top:22px">
      <a href={`/questions/${q.id}`}>Every voice on this question<span>{q.placed.length}</span></a>
      {others.map(y => <a href={`/questions/${q.id}/${y.slug}`}>{TRAD[y.t][0]}<span>{y.placed.length}</span></a>)}
    </div>
  </section>
  {elsewhere.length > 0 && (
    <section>
      <h2 class="h-src">{who} on other questions</h2>
      <div class="index" style="margin-top:22px">{elsewhere.map(y => <a href={`/questions/${y.q.id}/${y.slug}`}>{TOPIC[y.q.id].charAt(0).toUpperCase() + TOPIC[y.q.id].slice(1)}<span>{y.placed.length}</span></a>)}</div>
    </section>
  )}
  <p class="def" style="margin-top:60px">A tradition here is a label for browsing, and a passage is filed under one. Placements were read twice by machine and not yet by a human editor. <a href="/how-it-works">How it works</a>.</p>
  <Coffee />
</Read>
