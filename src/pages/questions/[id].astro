---
import Coffee from '../../components/Coffee.astro';
import Read from '../../layouts/Read.astro';
import { questions, slugify, SECOND, REGIONS, TRADITIONS, TOPIC, TRAD, tradSets } from '../../lib/atlas.js';
export function getStaticPaths() { return questions.map(q => ({ params: { id: q.id }, props: { q } })); }
const { q } = Astro.props;
const scored = q.steps.filter(s => s.tone !== 'none');
const count = s => q.placed.filter(c => c.score === s.id).length;
const total = q.placed.length, first = q.placed[0], last = q.placed.at(-1);
// One voice to open with: short, agreed by both readers, from the middle of the scale where there is one.
const mid = scored[Math.floor(scored.length / 2)];
const LEAD = { death: 'confucius-death' };
const lead = q.placed.find(c => c.id === LEAD[q.id]) || q.placed.find(c => c.second === 'agreed' && c.score === mid.id && c.excerpt.length < 170 && !c.translation) || q.placed.find(c => c.second === 'agreed' && c.excerpt.length < 170);
const HEAVY = { death: true, suffering: true };
const traditions = TRADITIONS.filter(t => q.placed.some(c => c.tradition === t));
const regions = REGIONS.filter(([id]) => q.placed.some(c => c.region === id));
const cite = c => `“${c.excerpt}” — ${c.name}, ${c.work} (${c.dateShort}). ${c.readUrl}`;
// A few short passages, one for each answer and from different traditions, chosen by hand for reading aloud with a child.
const CHILD = { death: ['confucius-death', 'barbauld-death', 'tiruvalluvar-death', 'bhagavad-gita-death', 'epictetus-death'] };
const childSet = (CHILD[q.id] || []).map(id => q.placed.find(c => c.id === id)).filter(Boolean);
const words = q.plain.split(' '), cut = Math.max(1, words.length - 3);
const sets = tradSets.filter(x => x.q.id === q.id);
const desc = `${q.plain} Quotes on ${TOPIC[q.id] || q.short.toLowerCase()} from ${total} thinkers, scriptures and traditions, ${first.dateShort} to ${last.dateShort}, each with its source: ${scored.map(s => `${count(s)} say “${s.plain.toLowerCase()}”`).join(', ')}.`;
const desc0 = `${q.plain} ${total} passages from ${first.dateShort} to ${last.dateShort}, in their authors’ own words: ${scored.map(s => `${count(s)} say “${s.plain.toLowerCase()}”`).join(', ')}.`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: q.plain, description: desc, url: `https://svapnaproject.org/questions/${q.id}`,
  mainEntity: { '@type': 'ItemList', numberOfItems: total, itemListElement: q.placed.slice(0, 25).map((c, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Quotation', text: c.excerpt, spokenByCharacter: { '@type': 'Person', name: c.name }, url: `https://svapnaproject.org/thinkers/${slugify(c.name)}#${c.id}` } })) } };
---
<Read title={`${q.plain} Quotes on ${TOPIC[q.id] || 'it'} from ${total} voices across 4,000 years — Svapna`} description={desc} path={`/questions/${q.id}`} image={`/og/q-${q.id}.jpg`} crumbs={[{ name: 'Questions', path: '/questions' }, { name: q.plain, path: `/questions/${q.id}` }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/questions">Questions</a></p>
  <h1>{words.slice(0, cut).join(' ')} <em>{words.slice(cut).join(' ')}</em></h1>
  <p class="lede">{total} passages from {first.dateShort} to {last.dateShort}, each in its author’s own words. Put more exactly, the question is: {q.question.charAt(0).toLowerCase() + q.question.slice(1)}</p>
  {lead && <figure class="lead-voice"><blockquote>“{lead.excerpt}”</blockquote><figcaption><a href={`#${lead.id}`}>{lead.name}</a> · {lead.dateShort} · one of {total} voices</figcaption></figure>}
  {HEAVY[q.id] && <p class="def gentle">These are the thoughts and opinions of others, gathered across four thousand years. For anyone in crisis, <a href="https://findahelpline.com" target="_blank" rel="noopener">findahelpline.com</a> lists free, confidential lines by country.</p>}
  {childSet.length > 0 && (
    <details class="child-set">
      <summary>For reading with a child</summary>
      <p class="def">{childSet.length} short passages from different traditions.</p>
      {childSet.map(c => <figure><blockquote lang={c.lang || undefined} translate={c.lang ? 'no' : undefined}>“{c.translation || c.excerpt}”</blockquote><figcaption><a href={`#${c.id}`}>{c.name}</a> · {c.place.split(',').slice(-1)[0].trim()} · {c.dateShort}</figcaption></figure>)}
    </details>
  )}
  <a class="go" href={`/#${q.id}`}>Answer it and see the world light up →</a>
  <div class="tally" aria-hidden="true">{q.steps.map(s => count(s) > 0 && <i style={`flex:${count(s)};background:var(--${s.tone})`}></i>)}</div>
  <div class="find" id="find"><input id="find-q" type="search" placeholder="Find a name, a place or a word" aria-label="Find a name, a place or a word" /><span class="find-eras">{[['all', 'All of time'], ['a', 'Before 1 CE'], ['b', '1–1500'], ['c', '1500–1900'], ['d', 'Since 1900']].map(([id, label]) => <button type="button" data-era={id} aria-pressed={String(id === 'all')}>{label}</button>)}</span><span class="small" id="find-n" aria-live="polite"></span>
    <span class="find-eras find-regions"><button type="button" data-region="all" aria-pressed="true">Everywhere</button>{regions.map(([id, label]) => <button type="button" data-region={id} aria-pressed="false">{label}</button>)}</span>
    <label class="find-t"><span class="small">Tradition</span> <select id="find-t"><option value="">Any</option>{traditions.map(t => <option value={t}>{t}</option>)}</select></label>
    <label class="find-short"><input type="checkbox" id="find-short" /> <span class="small">Short enough to read aloud</span></label>
    <span class="find-do"><button type="button" id="find-link">Copy a link to this set</button><button type="button" id="find-print">Print it</button><span class="small" id="find-ok" role="status"></span></span></div>
  <p class="small tally-note">A count of the passages gathered here so far. It is not a vote, and no answer is ranked above another.</p>
  <p class="keys">{q.steps.map(s => count(s) > 0 && <a href={`#${s.id}`}><span class="dot" style={`--c:var(--${s.tone})`}></span><b>{count(s)}</b> {s.plain.toLowerCase()}{s.tone === 'none' ? ' (does not fit the scale)' : ''}</a>)}</p>

  {q.steps.map(s => count(s) > 0 && (
    <section id={s.id}>
      <h2><span class="dot" style={`--c:var(--${s.tone})`}></span>{s.plain}</h2>
      <p class="def">{s.definition}</p>
      <div class="rows">
        {q.placed.filter(c => c.score === s.id).map(c => (
          <article class="row" id={c.id} data-y={c.sortYear} data-r={c.region} data-t={c.tradition} data-w={(c.translation || c.excerpt).split(/\s+/).length}>
            <div>
              <blockquote lang={c.lang || undefined} translate={c.lang ? 'no' : undefined}>“{c.excerpt}”</blockquote>
              {c.translation && <p class="tr">{c.translation}</p>}
              <p class="why">{c.why}</p>
              {SECOND[c.second] && <p class={`twice ${c.second}`}>{SECOND[c.second]}</p>}
            </div>
            <div class="who">
              <a class="name" href={`/thinkers/${slugify(c.name)}#${c.id}`}>{c.name}</a>
              <p>{c.place}</p><p>{c.dateShort}</p><p>{c.work}</p>
              <a class="src" href={c.readUrl} target="_blank" rel="noopener">Read it at the source ↗</a>
              <button class="src quiet say" type="button" data-say={`${c.translation || c.excerpt} ${c.name}.`} hidden>Listen</button>
              <button class="src quiet" type="button" data-copy={cite(c)}>Copy with citation</button>
              <button class="src quiet keep" type="button" data-keep={c.id} data-name={c.name} data-text={c.excerpt} data-href={`/thinkers/${slugify(c.name)}#${c.id}`} data-cite={`${c.work} (${c.dateShort}). ${c.readUrl}`}>Keep this passage</button>
              <a class="src quiet" href={`/about/contact?about=${q.id}:${c.id}`} rel="nofollow">Correct or disagree?</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
  {sets.length > 0 && (
    <section id="by-tradition">
      <h2 class="h-src">By tradition</h2>
      <div class="index" style="margin-top:22px">{sets.map(x => <a href={`/questions/${q.id}/${x.slug}`}>What {TRAD[x.t][0]} {TRAD[x.t][1] ? 'says' : 'say'} about {TOPIC[q.id]}<span>{x.placed.length}</span></a>)}</div>
    </section>
  )}
  <p class="def" style="margin-top:60px">How passages are checked and placed, and how far to trust a placement: <a href="/how-it-works">how Svapna works</a>.</p>
  <script is:inline>
    (function () {
      var q = document.getElementById('find-q'), n = document.getElementById('find-n'), rows = [].slice.call(document.querySelectorAll('.row[data-y]')), era = 'all', region = 'all', ts = document.getElementById('find-t'), sh = document.getElementById('find-short'), text = rows.map(function (r) { return r.textContent.toLowerCase(); });
      var inEra = function (y) { return era === 'all' || (era === 'a' ? y < 1 : era === 'b' ? y >= 1 && y < 1500 : era === 'c' ? y >= 1500 && y < 1900 : y >= 1900); };
      function run() {
        var w = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean), shown = 0;
        rows.forEach(function (r, i) { var ok = inEra(+r.dataset.y) && (region === 'all' || r.dataset.r === region) && (!ts.value || r.dataset.t === ts.value) && (!sh.checked || +r.dataset.w <= 25) && w.every(function (x) { return text[i].indexOf(x) >= 0; }); r.hidden = !ok; if (ok) shown++; });
        document.querySelectorAll('main section[id]').forEach(function (s) { if (s.querySelector('.row[data-y]')) s.hidden = !s.querySelector('.row[data-y]:not([hidden])'); });
        n.textContent = shown === rows.length ? '' : shown + ' of ' + rows.length + ' passages';
        var u = new URL(location.href); [['find', q.value.trim()], ['era', era === 'all' ? '' : era], ['region', region === 'all' ? '' : region], ['tradition', ts.value], ['short', sh.checked ? '1' : '']].forEach(function (x) { if (x[1]) u.searchParams.set(x[0], x[1]); else u.searchParams.delete(x[0]); }); history.replaceState(null, '', u.pathname + u.search + location.hash);
      }
      q.addEventListener('input', run); ts.addEventListener('change', run); sh.addEventListener('change', run);
      var press = function (sel, key, val) { document.querySelectorAll(sel).forEach(function (x) { x.setAttribute('aria-pressed', String(x.dataset[key] === val)); }); };
      document.querySelectorAll('.find-regions button').forEach(function (b) { b.addEventListener('click', function () { region = b.dataset.region; press('.find-regions button', 'region', region); run(); }); });
      document.getElementById('find-print').addEventListener('click', function () { print(); });
      document.getElementById('find-link').addEventListener('click', function () { var ok = document.getElementById('find-ok'); navigator.clipboard.writeText(location.href.split('#')[0]).then(function () { ok.textContent = 'Link copied.'; }, function () { ok.textContent = location.href; }); setTimeout(function () { ok.textContent = ''; }, 2600); });
      // A shared link restores the same set.
      (function () { var sp = new URLSearchParams(location.search), f = sp.get('find'), e = sp.get('era'), r = sp.get('region'), t = sp.get('tradition'), sw = sp.get('short'); if (!f && !e && !r && !t && !sw) return; if (sw) sh.checked = true; if (t) { ts.value = t; if (ts.value !== t) ts.value = ''; } if (f) q.value = f.slice(0, 80); if (/^[abcd]$/.test(e || '')) { era = e; press('.find-eras:not(.find-regions) button', 'era', era); } if (r && document.querySelector('.find-regions button[data-region="' + r.replace(/[^a-z]/g, '') + '"]')) { region = r; press('.find-regions button', 'region', region); } run(); })();
      document.querySelectorAll('.find-eras:not(.find-regions) button').forEach(function (b) { b.addEventListener('click', function () { era = b.dataset.era; press('.find-eras:not(.find-regions) button', 'era', era); run(); }); });
    })();
  </script>
  <Coffee />
</Read>
