---
// A full lesson, in the reading look. Lessons belong to a depth of the night in Dreaming.
import Coffee from '../../../components/Coffee.astro';
import Read from '../../../layouts/Read.astro';
import MarkdownBody from '../../../components/MarkdownBody.astro';
import InlineMarkdown from '../../../components/InlineMarkdown.astro';
import { curriculumModules } from '../../../lib/content.js';
import { lessonsByModule } from '../../../lib/lessons.js';
import { articleSchema } from '../../../lib/seo.js';
import shorts from '../../../data/dream_shorts.json';

export function getStaticPaths() {
  const paths = [];
  for (const mod of curriculumModules) {
    const padded = String(parseInt(mod.num, 10)).padStart(2, '0');
    const lessons = lessonsByModule[String(parseInt(mod.num, 10))] || [];
    for (const l of lessons) paths.push({ params: { num: padded, lesson: l.urlSlug }, props: { mod, lesson: l, lessons } });
  }
  return paths;
}
const { mod, lesson, lessons } = Astro.props;
const pad = n => String(parseInt(n, 10)).padStart(2, '0');
const padded = pad(mod.num);
const idx = lessons.findIndex(l => l.urlSlug === lesson.urlSlug);
const prev = idx > 0 ? lessons[idx - 1] : null, next = idx < lessons.length - 1 ? lessons[idx + 1] : null;
const nextMod = curriculumModules[curriculumModules.indexOf(mod) + 1];
const nextModFirst = nextMod ? (lessonsByModule[String(parseInt(nextMod.num, 10))] || [])[0] : null;
const LAYER = { awake: 'Awake', drifting: 'Drifting', deep: 'Deep sleep', dreaming: 'Dreaming', lucid: 'Knowing it is a dream', working: 'Working with the dream', ground: 'The ground beneath', morning: 'Morning' };
const short = shorts.find(s => s.module === parseInt(lesson.moduleNum, 10) && s.lesson === parseInt(lesson.lessonNum, 10));
const path = `/curriculum/module-${padded}/${lesson.urlSlug}`;
const kicker = (lesson.kicker || '').replace(/[*_]/g, '');
const description = (short ? short.short : kicker || lesson.title).slice(0, 180);
const jsonLd = articleSchema({ url: 'https://svapnaproject.org' + path, headline: lesson.title, description, section: `Dreaming / ${mod.title}` });
---
<Read title={`${lesson.title} — Dreaming, Svapna`} description={description} path={path}
  crumbs={[{ name: 'Dreaming', path: '/dream' }, { name: lesson.title, path }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a>{short && <> · <a href={`/dream#${short.layer}`}>{LAYER[short.layer]}</a></>} · {mod.title}</p>
  <h1 class="h-read">{lesson.title}</h1>
  {kicker && <p class="lede">{kicker}</p>}
  <div class="prose"><MarkdownBody text={lesson.body} /></div>
  {lesson.prompt && <p class="prompt">“<InlineMarkdown text={lesson.prompt} />”</p>}
  <nav class="turn">
    {prev ? <a href={`/curriculum/module-${padded}/${prev.urlSlug}`}><span class="small">Before</span>{prev.title}</a> : <span></span>}
    {next ? <a class="r" href={`/curriculum/module-${padded}/${next.urlSlug}`}><span class="small">Next</span>{next.title}</a>
      : nextModFirst ? <a class="r" href={`/curriculum/module-${pad(nextMod.num)}/${nextModFirst.urlSlug}`}><span class="small">Next · {nextMod.title}</span>{nextModFirst.title}</a> : <span></span>}
  </nav>
  {short && <a class="go" href={`/dream#${short.layer}`}>Back into the night at “{LAYER[short.layer]}” →</a>}
  <script is:inline>try { var F = JSON.parse(localStorage.getItem('svapna_done') || '{}') || {}; F.lesson = 1; localStorage.setItem('svapna_done', JSON.stringify(F)); } catch (e) {}</script>
  <Coffee line="If this lesson was worth reading, a coffee keeps Svapna open." />
</Read>
