---
import Coffee from '../../components/Coffee.astro';
import Read from '../../layouts/Read.astro';
import { thinkers, thinkerOf, SECOND, questions, slugify, regionName, TOPIC, isText } from '../../lib/atlas.js';
export function getStaticPaths() { return thinkers.map(t => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props;
const n = t.own.length, qs = [...new Set(t.passages.map(p => p.question.plain))];
const lead = t.own[0];
// Where to read next: one voice at the other end of a question this thinker answered, and one who agrees from elsewhere in the world.
const base = t.passages.find(p => p.home && p.step && p.step.tone !== 'none') || t.passages.find(p => p.step && p.step.tone !== 'none');
const nextUp = [];
if (base) {
  const q = questions.find(x => x.id === base.question.id), order = q.steps.filter(x => x.tone !== 'none'), i = order.findIndex(x => x.id === base.step.id);
  const far = order[i === 0 ? order.length - 1 : i === order.length - 1 ? 0 : 0], pool = q.placed.filter(c => c.name !== t.name && c.second !== 'differed');
  const near = (list) => list.sort((a, b) => Math.abs(a.sortYear - base.card.sortYear) - Math.abs(b.sortYear - base.card.sortYear))[0];
  const other = near(pool.filter(c => c.score === far.id)), same = near(pool.filter(c => c.score === base.step.id && c.region !== base.card.region));
  if (other) nextUp.push({ label: `Answers the other way: ${far.plain.toLowerCase()}`, c: other, q });
  if (same) nextUp.push({ label: `Says much the same, from ${regionName(same.region)}`, c: same, q });
}
const desc = `${t.name} in ${n === 1 ? 'their own words' : `${n} passages`}, ${t.when}, ${t.where}: “${lead.excerpt.slice(0, 110)}${lead.excerpt.length > 110 ? '…' : ''}” On ${qs.slice(0, 3).join(' ').toLowerCase()}`;
const topics = [...new Set(t.passages.map(p => TOPIC[p.question.id]).filter(Boolean))];
const topicText = topics.length > 2 ? topics.slice(0, 3).join(', ') + (topics.length > 3 ? ' and more' : '') : topics.join(' and ');
const seoTitle = `${t.name} on ${topics.slice(0, 3).join(', ').replace(/, ([^,]*)$/, ' and $1')}: quotes with sources — Svapna`;
const seoDesc = `${t.about ? t.about + ' ' : ''}${n === 1 ? 'One passage' : n + ' passages'} on ${topicText}, each quoted from a named source: “${lead.excerpt.slice(0, 90)}${lead.excerpt.length > 90 ? '…' : ''}”`;
const jsonLd0 = { '@context': 'https://schema.org', '@type': 'ProfilePage', url: `https://svapnaproject.org/thinkers/${t.slug}`, mainEntity: { '@type': 'Person', name: t.name, description: `Passages by ${t.name} on ${qs.length} of life’s big questions.` } };
const url = `https://svapnaproject.org/thinkers/${t.slug}`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ProfilePage', url, name: seoTitle.replace(' — Svapna', ''), description: seoDesc,
  mainEntity: { '@type': isText(t.name) ? 'CreativeWork' : 'Person', name: t.name, ...(t.about ? { description: t.about } : {}) },
  hasPart: t.own.slice(0, 20).map(c => ({ '@type': 'Quotation', text: c.excerpt, url: url + '#' + c.id, creator: { '@type': isText(t.name) ? 'Organization' : 'Person', name: t.name }, isBasedOn: { '@type': 'CreativeWork', name: c.work, url: c.readUrl } })) };
---
<Read title={seoTitle} description={seoDesc} path={`/thinkers/${t.slug}`} image={`/og/q-${(t.passages.find(p => p.home) || t.passages[0]).question.id}.jpg`} crumbs={[{ name: 'Thinkers', path: '/thinkers' }, { name: t.name, path: `/thinkers/${t.slug}` }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/thinkers">Thinkers</a></p>
  <h1>{t.name}</h1>
  <p class="lede">{t.where} · {t.when}{n > 1 ? ` · ${n} passages` : ''}. {qs.length === 1 ? 'One question answered' : `${qs.length} questions answered`}, in this voice’s own words.</p>

  {t.about && <p class="who-line">{t.about} <span class="small">{t.tradition !== 'Other' ? t.tradition : ''}</span></p>}

  <div class="rows" style="margin-top:56px">
    {t.own.map(c => {
      const places = t.passages.filter(p => p.card.id === c.id), home = places.find(p => p.home) || places[0];
      return (
        <article class="row" id={c.id}>
          <div>
            <blockquote lang={c.lang || undefined} translate={c.lang ? 'no' : undefined}>“{c.excerpt}”</blockquote>
            {c.translation && <p class="tr">{c.translation}</p>}
            {places.map(p => (
              <div style="margin-top:22px">
                <p class="pos" style={`--c:var(--${p.step.tone})`}><span class="dot"></span><a href={`/questions/${p.question.id}#${c.id}`}>{p.question.plain}</a> {p.step.plain}</p>
                <p class="why">{p.why}</p>
                {SECOND[p.second] && <p class={`twice ${p.second}`}>{SECOND[p.second]} <a href={`/about/contact?about=${p.question.id}:${c.id}`} rel="nofollow">Correct or disagree?</a></p>}
              </div>
            ))}
            <p class="why"><b>What it doesn’t show.</b> {home.limit}</p>
          </div>
          <div class="who">
            <p>{c.work}</p><p>{c.dateFull || c.dateShort}</p><p>{c.place}</p><p>{c.sourceLabel}</p>
            <a class="src" href={c.readUrl} target="_blank" rel="noopener">Read it at the source ↗</a>
            {c.checked && <p class="small">Quote checked against the source on {c.checked}</p>}
            <button class="src quiet say" type="button" data-say={`${c.translation || c.excerpt} ${c.name}.`} hidden>Listen</button>
            <a class="src" href={`/#${home.question.id}`}>See it on the world →</a>
            <button class="src quiet" type="button" data-copy={`“${c.excerpt}” — ${c.name}, ${c.work} (${c.dateShort}). ${c.readUrl}`}>Copy with citation</button>
            <button class="src quiet keep" type="button" data-keep={c.id} data-name={c.name} data-text={c.excerpt} data-href={`/thinkers/${t.slug}#${c.id}`} data-cite={`${c.work} (${c.dateShort}). ${c.readUrl}`}>Keep this passage</button>
          </div>
        </article>
      );
    })}
  </div>

  {t.circles.length > 0 && (
    <section>
      <h2>Circles</h2>
      <p class="def">Where these passages, taken together, place this voice.</p>
      <div class="qlist small-list">{t.circles.map(c => <a href={`/circles/${c.id}`}>{c.name}<span>from {c.n} answers →</span></a>)}</div>
    </section>
  )}

  {t.ties.length > 0 && (
    <section>
      <h2>Documented connections</h2>
      <div class="ties">
        {t.ties.map(l => (
          <p>{l.out ? <>{t.name} {l.verb} {thinkerOf(l.other) ? <a href={`/thinkers/${l.otherSlug}`}>{l.other}</a> : l.other}</> : <>{thinkerOf(l.other) ? <a href={`/thinkers/${l.otherSlug}`}>{l.other}</a> : l.other} {l.verb} {t.name}</>}{l.year ? ` (${l.year})` : ''}. <span>{l.summary} {l.caveat}</span></p>
        ))}
      </div>
    </section>
  )}
  {nextUp.length > 0 && (
    <section>
      <h2 class="h-src">Read next</h2>
      <p class="def">On “{nextUp[0].q.plain}”</p>
      <div class="rows" style="margin-top:22px">
        {nextUp.map(n => <article class="row term"><div><p class="small">{n.label}</p><a class="name-plain" href={`/thinkers/${slugify(n.c.name)}#${n.c.id}`}>{n.c.name}</a><p class="small">{n.c.dateShort} · {n.c.place.split(',').slice(-1)[0].trim()}</p></div><div><p class="term-def">“{n.c.translation || n.c.excerpt}”</p></div></article>)}
      </div>
    </section>
  )}
  <p class="def" style="margin-top:60px">To cite: Svapna, “{t.name}”, svapnaproject.org/thinkers/{t.slug}. Cite the linked source for the words themselves. <a href="/how-it-works">How passages are checked and placed</a>.</p>
  <Coffee />
  <script is:inline define:vars={{ slug: t.slug }}>
    try { var F = JSON.parse(localStorage.getItem('svapna_done') || '{}') || {}; F.thinkers = F.thinkers || []; if (F.thinkers.indexOf(slug) < 0 && F.thinkers.length < 40) { F.thinkers.push(slug); localStorage.setItem('svapna_done', JSON.stringify(F)); } } catch (e) {}
  </script>
</Read>
