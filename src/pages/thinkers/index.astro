---
import Read from '../../layouts/Read.astro';
import { thinkers, REGIONS } from '../../lib/atlas.js';
const regions = REGIONS.map(([id, label]) => [id, label, thinkers.filter(t => t.region === id).length]).filter(r => r[2]);
const letters = [...new Set(thinkers.map(t => (t.sort[0] || '#').toUpperCase()))];
---
<Read title={`${thinkers.length} thinkers and texts — Svapna`} description={`Every thinker and text in the atlas, from the Pyramid Texts to today: ${thinkers.length} voices from every continent, each with their own words on life’s big questions.`} path="/thinkers" crumbs={[{ name: 'Thinkers', path: '/thinkers' }]}>
  <p class="small crumb"><a href="/">Svapna</a> · Thinkers</p>
  <h1>{thinkers.length} <em>voices.</em></h1>
  <p class="lede">Every thinker and text in the atlas, from about 2400 BCE to today. Each page gathers that voice’s own words on the questions, where they were written, and where to read them.</p>
  <div class="find"><input id="find-q" type="search" placeholder="Find a thinker or a text" aria-label="Find a thinker or a text" /><span class="small" id="find-n" aria-live="polite"></span>
    <span class="find-eras find-regions"><button type="button" data-region="all" aria-pressed="true">Everywhere</button>{regions.map(([id, label, n]) => <button type="button" data-region={id} aria-pressed="false">{label} · {n}</button>)}</span>
    <a class="small" id="find-all" href="/search">Search every passage for a word →</a></div>
  <div class="index" id="index">
    {letters.map(L => (
      <>
        <p class="letter">{L}</p>
        {thinkers.filter(t => (t.sort[0] || '#').toUpperCase() === L).map(t => <a href={`/thinkers/${t.slug}`} data-r={t.region}>{t.name}<span>{t.when}</span></a>)}
      </>
    ))}
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById('find-q'), n = document.getElementById('find-n'), box = document.getElementById('index'), items = [].slice.call(box.querySelectorAll('a')), fold = function (t) { return t.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }, text = items.map(function (a) { return fold(a.textContent); });
      var region = 'all', all = document.getElementById('find-all');
      function run() {
        var w = fold(q.value.trim()), shown = 0; items.forEach(function (a, i) { var ok = (!w || text[i].indexOf(w) >= 0) && (region === 'all' || a.dataset.r === region); a.hidden = !ok; if (ok) shown++; });
        var narrowed = Boolean(w) || region !== 'all'; box.querySelectorAll('.letter').forEach(function (l) { l.hidden = narrowed; });
        n.textContent = narrowed ? shown + ' of ' + items.length : '';
        all.href = '/search' + (w ? '?q=' + encodeURIComponent(q.value.trim()) : ''); all.textContent = w ? 'Search every passage for “' + q.value.trim() + '” →' : 'Search every passage for a word →';
      }
      q.addEventListener('input', run);
      document.querySelectorAll('.find-regions button').forEach(function (b) { b.addEventListener('click', function () { region = b.dataset.region; document.querySelectorAll('.find-regions button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); }); run(); }); });
    })();
  </script>
</Read>
