---
// Search every passage in the atlas by any word: a name, a place, a work, or the words themselves.
import Read from '../layouts/Read.astro';
import { cards, thinkers } from '../lib/atlas.js';
---
<Read title="Search every passage — Svapna" description={`Search ${cards.length} verified passages from ${thinkers.length} thinkers and texts by name, place, work or the words themselves.`} path="/search" crumbs={[{ name: 'Search', path: '/search' }]}>
  <p class="small crumb"><a href="/">Svapna</a> · Search</p>
  <h1>Find <em>the words.</em></h1>
  <p class="lede">{cards.length} passages from {thinkers.length} thinkers and texts. Search by a name, a place, a work, or a word in the passage itself.</p>
  <div class="find"><input id="sq" type="search" placeholder="solitude · Marcus Aurelius · Kyoto · Bhagavad Gita" aria-label="Search every passage" autocomplete="off" /><span class="small" id="sn" aria-live="polite"></span></div>
  <div class="rows" id="sr" style="margin-top:40px"></div>
  <noscript><p class="def">Search needs JavaScript. Every passage can also be browsed from the <a href="/questions">questions</a> and the <a href="/thinkers">thinkers</a>.</p></noscript>
  <script is:inline>
    (function () {
      var q = document.getElementById('sq'), n = document.getElementById('sn'), box = document.getElementById('sr'), data = null, text = null, loading = false;
      var fold = function (t) { return t.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); };
      var el = function (tag, cls, t) { var x = document.createElement(tag); if (cls) x.className = cls; if (t != null) x.textContent = t; return x; };
      function load(then) { if (data) return then(); if (loading) return; loading = true; n.textContent = 'Loading the passages…'; fetch('/data/search.json').then(function (r) { return r.json(); }).then(function (d) { data = d; text = d.map(function (c) { return fold([c.n, c.e, c.t, c.w, c.p, c.d].join(' ')); }); then(); }).catch(function () { n.textContent = 'The passages could not be loaded. Try again.'; loading = false; }); }
      function run() {
        var w = fold(q.value.trim()).split(/\s+/).filter(function (x) { return x.length > 1; }); box.textContent = '';
        var u = new URL(location.href); if (q.value.trim()) u.searchParams.set('q', q.value.trim()); else u.searchParams.delete('q'); history.replaceState(null, '', u.pathname + u.search);
        if (!w.length) { n.textContent = ''; return; }
        var hits = []; for (var i = 0; i < data.length; i++) { var ok = true; for (var k = 0; k < w.length; k++) if (text[i].indexOf(w[k]) < 0) { ok = false; break; } if (ok) hits.push(data[i]); }
        n.textContent = hits.length + (hits.length === 1 ? ' passage' : ' passages') + (hits.length > 80 ? ', first 80 shown' : '');
        hits.slice(0, 80).forEach(function (c) {
          var row = el('article', 'row'), a = el('div'), b = el('div', 'who'); a.append(el('blockquote', '', '“' + c.e + '”')); if (c.t) a.append(el('p', 'tr', c.t)); a.append(el('p', 'why', c.q.join(' · ')));
          var name = el('a', 'name', c.n); name.href = '/thinkers/' + c.s + '#' + c.i; b.append(name, el('p', '', c.p), el('p', '', c.d), el('p', '', c.w));
          var src = el('a', 'src', 'Read it at the source ↗'); src.href = c.u; src.target = '_blank'; src.rel = 'noopener'; var cp = el('button', 'src quiet', 'Copy with citation'); cp.type = 'button'; cp.dataset.copy = '“' + c.e + '” — ' + c.n + ', ' + c.w + ' (' + c.d + '). ' + c.u;
          b.append(src, cp); row.append(a, b); box.append(row); });
      }
      q.addEventListener('input', function () { load(run); });
      var first = new URLSearchParams(location.search).get('q'); if (first) { q.value = first.slice(0, 80); load(run); } else q.focus();
    })();
  </script>
</Read>
