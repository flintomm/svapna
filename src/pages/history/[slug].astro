---
import Read from '../../layouts/Read.astro';
import Coffee from '../../components/Coffee.astro';
import { historyUnits, articles } from '../../lib/content.js';
import { lessonsByModule } from '../../lib/lessons.js';
import { articleSchema } from '../../lib/seo.js';
import timelineData from '../../data/timeline.json';
import quotesData from '../../data/quotes.json';
export function getStaticPaths() { return historyUnits.map(u => ({ params: { slug: u.slug }, props: { unit: u } })); }
const { unit } = Astro.props;
const n = { I: 1, II: 2, III: 3, IV: 4, V: 5, VI: 6 }[unit.num];
const article = articles.find(a => a.id === unit.articleId);
const lessons = lessonsByModule[String(parseInt(unit.moduleNum, 10))] || [];
const pad = String(parseInt(unit.moduleNum, 10)).padStart(2, '0');
const events = timelineData.entries.filter(e => e.unit === n).sort((a, b) => a.sort_key - b.sort_key);
const voices = quotesData.quotes.filter(q => q.unit === n).slice(0, 3);
const idx = historyUnits.indexOf(unit), prev = idx > 0 ? historyUnits[idx - 1] : null, next = idx < historyUnits.length - 1 ? historyUnits[idx + 1] : null;
const path = `/history/${unit.slug}`;
---
<Read title={`${unit.title} (${unit.date}): the history of dream practice — Svapna`} description={unit.blurb.slice(0, 180)} path={path} crumbs={[{ name: 'Dreaming', path: '/dream' }, { name: unit.title, path }]} jsonLd={articleSchema({ url: 'https://svapnaproject.org' + path, headline: unit.title, description: unit.blurb, section: 'History' })}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a> · <a href="/dream#by-date">By date</a> · Era {n} of {historyUnits.length}</p>
  <h1 class="h-read">{unit.title}</h1>
  <p class="small" style="margin-top:16px">{unit.date} · {unit.figures.join(' · ')}</p>
  <p class="lede">{unit.blurb}</p>
  {article && <a class="go" href={`/library/articles/${article.id}`}>Read the full essay ({Math.round(article.word_count / 230)} min) →</a>}

  {voices.length > 0 && (
    <section><h2>In their words</h2><div class="rows">
      {voices.map(q => <article class="row"><div><blockquote>“{q.text}”</blockquote></div><div class="who"><p class="name-plain">{q.attribution}</p><p>{q.citation}</p></div></article>)}
    </div></section>
  )}
  <section><h2>What happened, in order</h2><div class="rows">
    {events.map(e => <article class="row term"><div><p class="src-title">{e.date.replace(/^(\d{4})-\d\d-\d\d$/, '$1')}</p><p class="small">{e.tradition}</p></div><div><p class="src-title" style="font-style:normal;font-family:'Inter Tight',sans-serif;font-weight:600;font-size:19px;letter-spacing:-.03em">{e.title}</p><p class="term-def" style="margin-top:6px">{e.summary}</p></div></article>)}
  </div></section>
  {lessons.length > 0 && (
    <section><h2>The lessons of this era</h2><div class="qlist small-list">
      {lessons.map(l => <a href={`/curriculum/module-${pad}/${l.urlSlug}`}>{l.title}<span>Read →</span></a>)}
    </div></section>
  )}
  <nav class="turn">
    {prev ? <a href={`/history/${prev.slug}`}><span class="small">Before</span>{prev.title}</a> : <span></span>}
    {next ? <a class="r" href={`/history/${next.slug}`}><span class="small">Next</span>{next.title}</a> : <span></span>}
  </nav>
  <Coffee />
</Read>
