---
import Read from '../../layouts/Read.astro';
import PlainForm from '../../components/PlainForm.astro';
import { aboutPages } from '../../lib/content.js';

export function getStaticPaths() {
  return Object.keys(aboutPages).map(key => ({ params: { page: key } }));
}
const { page } = Astro.params;
const data = aboutPages[page];
const tabs = [
  { id: 'conduct', label: 'Code of conduct' },
  { id: 'acknowledgments', label: 'Acknowledgments' },
  { id: 'disclaimer', label: 'Medical disclaimer' },
  { id: 'contact', label: 'Contact' },
  { id: 'privacy', label: 'Privacy' },
  { id: 'terms', label: 'Terms' },
].filter(t => aboutPages[t.id]);
---
<Read title={`${data.title} — Svapna`} description={data.kicker} path={`/about/${page}`} crumbs={[{ name: data.title, path: `/about/${page}` }]}>
  <p class="small crumb"><a href="/">Svapna</a> · About</p>
  <h1 class="h-read">{data.title}</h1>
  <p class="lede">{data.kicker}</p>
  <nav class="tabs" aria-label="About pages">{tabs.map(t => <a href={`/about/${t.id}`} aria-current={page === t.id ? 'page' : undefined}>{t.label}</a>)}</nav>
  <div class="prose">
    {data.paragraphs.map(p => <p>{p}</p>)}
    {data.sections && data.sections.map(s => (<section><h2 class="sec-name">{s.name}</h2>{s.paragraphs.map(p => <p>{p}</p>)}</section>))}
    {data.effective && <p class="small">Effective {data.effective}</p>}
  </div>
  {page === 'contact' && <PlainForm id="contact" askSubject button="Send the message" />}
</Read>
