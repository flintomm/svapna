---
import Read from '../../layouts/Read.astro';
import { AXES, circles, HOW_MANY } from '../../lib/atlas.js';
---
<Read title="The nine circles of thinkers — Svapna" description="Nine circles of thinkers, gathered by how they answered life’s big questions: what lies beyond, what is in our hands, and whether we are made alone or together." path="/circles" crumbs={[{ name: 'Circles', path: '/circles' }]}>
  <p class="small crumb"><a href="/">Svapna</a> · Circles</p>
  <h1>Nine <em>circles.</em></h1>
  <p class="lede">Behind the {HOW_MANY} questions sit three larger ones. On each, thinkers across four thousand years fall into three circles. A thinker joins a circle when their own words, on at least two of its questions, lean that way.</p>
  <a class="go" href="/you">Find your own circles →</a>
  {AXES.map(ax => (
    <section>
      <h2>{ax.name}</h2>
      <p class="def">From their answers on: {ax.qs.length} questions.</p>
      <div class="qlist">
        {circles.filter(c => c.axis.id === ax.id).map(c => <a href={`/circles/${c.id}`}><span><span class="dot" style={`--c:var(--${c.tone})`}></span><b class="circle-name">{c.name}</b><i class="circle-line">{c.line}</i></span><span>{c.members.length} thinkers</span></a>)}
      </div>
    </section>
  ))}
</Read>
