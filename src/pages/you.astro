---
// You: answer the questions and see which thinkers think most like you, and which least.
// Answers are kept on the visitor's own device (localStorage 'svapna_answers'); nothing is sent anywhere.
import Coffee from '../components/Coffee.astro';
import Read from '../layouts/Read.astro';
import { questions, thinkers, AXES } from '../lib/atlas.js';
const AX = AXES.map(a => ({ id: a.id, name: a.name, qs: a.qs, tone: a.tone, circles: a.circles }));

const value = (q, id) => { const s = q.steps.filter(x => x.tone !== 'none'); const i = s.findIndex(x => x.id === id); return i < 0 ? null : (s.length > 1 ? i / (s.length - 1) : .5); };
const Q = questions.map(q => ({ id: q.id, plain: q.plain, steps: q.steps.filter(s => s.tone !== 'none').map(s => ({ id: s.id, plain: s.plain, tone: s.tone })) }));
// Each thinker's position on each question, from their own passages (the average where they have more than one).
const T = thinkers.map(t => {
  const pos = {}, say = {};
  for (const q of questions) {
    const mine = t.passages.filter(p => p.question.id === q.id && p.step && p.step.tone !== 'none');
    if (!mine.length) continue;
    pos[q.id] = +(mine.reduce((n, p) => n + value(q, p.step.id), 0) / mine.length).toFixed(3);
    const p = mine.find(x => x.home) || mine[0];
    say[q.id] = [p.card.excerpt, p.step.plain, p.card.id];
  }
  return { s: t.slug, n: t.name, w: t.when, p: pos, q: say };
}).filter(t => Object.keys(t.p).length >= 2);
---
<Read title="You: which thinkers think like you? — Svapna" description={`Answer fourteen of life’s big questions and see which of ${T.length} thinkers from four thousand years agree with you most, and which oppose you most, each in their own words.`} path="/you" crumbs={[{ name: 'You', path: '/you' }]}>
  <p class="small crumb"><a href="/">Svapna</a> · You</p>
  <h1>Who thinks <em>like you?</em></h1>
  <p class="lede">Answer as many of the fourteen questions as you like. The more you answer, the truer the match. <span id="where">Your answers stay on this device.</span></p>
  <div id="acct" class="acct" hidden>
    <p id="acct-out" hidden><a class="go" href="/join">Sign in to keep them across devices →</a></p>
    <div id="acct-in" hidden>
      <label class="small" for="name">Your display name</label>
      <p><input id="name" maxlength="40" placeholder="Choose a name" autocomplete="off" /><button type="button" class="go" id="name-save">Save</button><span class="small" id="name-ok"></span></p>
      <p><button type="button" class="go quiet" id="out">Sign out</button><button type="button" class="go quiet" id="del">Delete my account</button></p>
    </div>
  </div>

  <div id="friend" class="you-friend" hidden></div>
  <section id="result" class="you-result" hidden>
    <p class="you-head" id="you-head"></p>
    <p class="you-share"><button type="button" class="go" id="share">Share your match →</button><button type="button" class="go" id="share-compare" title="The link carries your answers" hidden>Send a friend a link to compare →</button><span class="small" id="share-ok" role="status"></span></p>
    <div class="you-cols">
      <div><p class="small">Closest to you</p><div id="near"></div></div>
      <div><p class="small">Furthest from you</p><div id="far"></div></div>
    </div>
    <p class="fine you-note">A match compares your answers with where each thinker’s own words were placed, on the questions you both answered. Those placements are draft readings, and a few quoted lines are not a whole philosophy.</p>
  </section>
  <p class="lede" id="need">Answer three questions to see your matches.</p>

  <section>
    <h2>Your stickers</h2>
    <p class="def">Leanings come from your answers and change as you answer more. Fourteen answers are not a philosophy; take them as an invitation to see who stands near you. The rest are for exploring.</p>
    <div class="stickers" id="stickers"></div>
  </section>

  <section>
    <h2 id="count">Your answers</h2>
    <div class="rows" id="qs">
      {Q.map(q => (
        <div class="row you-q" data-q={q.id}>
          <p class="you-ask">{q.plain}</p>
          <p class="you-opts">{q.steps.map(s => <button type="button" data-a={s.id} style={`--c:var(--${s.tone})`}><span class="dot"></span>{s.plain}</button>)}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:26px"><button type="button" class="go" id="clear">Clear my answers</button></p>
  </section>

  <section id="kept" hidden>
    <h2>Passages you kept</h2>
    <div class="rows" id="kept-list"></div>
  </section>

  <Coffee line="If your matches surprised you, a coffee keeps Svapna open." />
  <a id="you-bar" class="you-bar" href="#result" hidden></a>

  <script is:inline src="/account/supabase.js"></script>
  <script is:inline src="/account/config.js"></script>
  <script is:inline src="/account/account.js"></script>
  <script is:inline type="application/json" id="you-data" set:html={JSON.stringify({ Q, T, AX })}></script>
  <script is:inline>
    (function () {
      var Acct = window.SvapnaAccount || { ready: false };
      var D = JSON.parse(document.getElementById('you-data').textContent), Q = D.Q, T = D.T, KEY = 'svapna_answers';
      var A = {}; try { A = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { A = {}; }
      var val = {}; Q.forEach(function (q) { val[q.id] = {}; q.steps.forEach(function (s, i) { val[q.id][s.id] = q.steps.length > 1 ? i / (q.steps.length - 1) : .5; }); });
      var plainOf = function (q, id) { var s = q.steps.find(function (x) { return x.id === id; }); return s ? s.plain : ''; };
      var el = function (tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
      function save() { try { localStorage.setItem(KEY, JSON.stringify(A)); } catch (e) {} }
      function rank() {
        var mine = Object.keys(A).filter(function (k) { return val[k] && val[k][A[k]] != null; }), need = Math.min(3, mine.length), out = [];
        T.forEach(function (t) {
          var shared = mine.filter(function (k) { return t.p[k] != null; }); if (shared.length < Math.max(2, need)) return;
          var sum = 0, agree = 0; shared.forEach(function (k) { var d = Math.abs(val[k][A[k]] - t.p[k]); sum += 1 - d; if (d < .26) agree++; });
          // A thinker who shares only a few questions is pulled toward the middle, so a two-question fluke cannot top the list.
          out.push({ t: t, shared: shared, agree: agree, score: (sum + 1) / (shared.length + 2) });
        });
        return out;
      }
      function card(r, kind) {
        var box = el('details', 'you-match'), sum = el('summary');
        var name = el('span', 'you-name', r.t.n), meta = el('span', 'small', (kind === 'near' ? 'agrees with you on ' + r.agree : 'differs from you on ' + (r.shared.length - r.agree)) + ' of ' + r.shared.length + ' shared questions · ' + r.t.w);
        sum.append(name, meta); box.append(sum);
        r.shared.forEach(function (k) {
          var q = Q.find(function (x) { return x.id === k; }), row = el('div', 'you-line'), same = Math.abs(val[k][A[k]] - r.t.p[k]) < .26;
          row.append(el('p', 'small', q.plain));
          row.append(el('p', 'you-say', '“' + r.t.q[k][0] + '”'));
          row.append(el('p', 'small', (same ? 'Same as you: ' : 'You said “' + plainOf(q, A[k]) + '”. Placed at: ') + r.t.q[k][1]));
          box.append(row);
        });
        var a = el('a', 'go', 'All of ' + r.t.n + '’s passages →'); a.href = '/thinkers/' + r.t.s; box.append(a);
        return box;
      }
      var SEAL = { ring: '<circle cx="27" cy="27" r="24" fill="none" stroke="currentColor" stroke-width="1.5"/>', low: '<circle cx="27" cy="27" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/>', mid: '<path d="M27 18a9 9 0 0 1 0 18z" fill="currentColor"/><circle cx="27" cy="27" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/>', high: '<circle cx="27" cy="27" r="9" fill="currentColor"/>', star: '<path d="M27 15l3.4 8 8.6.8-6.5 5.7 2 8.5L27 33.500l-7.500 4.500 2-8.500-6.500-5.700 8.600-.800z" fill="currentColor"/>' };
      function sticker(name, line, glyph, on, href, tone) {
        var a = el(href && on ? 'a' : 'div', 'sticker' + (on ? '' : ' off')); if (href && on) a.href = href; if (tone) a.style.setProperty('--c', 'var(--' + tone + ')');
        a.innerHTML = '<svg viewBox="0 0 54 54" aria-hidden="true">' + SEAL.ring + SEAL[glyph] + '</svg>'; var d = el('div'); d.append(el('b', '', name), el('span', '', line)); a.append(d); return a;
      }
      function stickers(n) {
        var box = document.getElementById('stickers'), mine = []; box.textContent = '';
        D.AX.forEach(function (ax) {
          var vals = ax.qs.filter(function (k) { return A[k] && val[k] && val[k][A[k]] != null; }).map(function (k) { return val[k][A[k]]; });
          if (vals.length < 2) { box.append(sticker(ax.name, 'Answer ' + (2 - vals.length) + ' more of its ' + ax.qs.length + ' questions to find your leaning.', 'low', false)); return; }
          var m = vals.reduce(function (a, b) { return a + b; }, 0) / vals.length, b = m < .34 ? 0 : m > .66 ? 2 : 1, c = ax.circles[b]; mine.push(c[0]);
          box.append(sticker('You lean toward ' + c[1], c[2], ['low', 'mid', 'high'][b], true, '/circles/' + c[0], ax.tone[b]));
        });
        try { localStorage.setItem('svapna_circles', JSON.stringify(mine)); } catch (e) {}
        var F = {}; try { F = JSON.parse(localStorage.getItem('svapna_done') || '{}') || {}; } catch (e) {}
        var met = (F.thinkers || []).length;
        [['First answer', 'Answer one question.', n >= 1], ['Halfway', 'Answer seven questions.', n >= 7], ['All fourteen', 'Answer every question.', n >= Q.length],
          ['Through the night', 'Reach morning in Dreaming.', !!F.night, '/dream'], ['Went deeper', 'Open a depth of the night.', !!F.deeper, '/dream'],
          ['Close reader', 'Read a full lesson.', !!F.lesson, '/glossary'], ['Ten voices', 'Visit ten thinkers’ pages (' + Math.min(met, 10) + ' of 10).', met >= 10, '/thinkers']]
          .forEach(function (x) { box.append(sticker(x[0], x[1], 'star', x[2], x[3])); });
      }
      // A friend's answers can arrive in the address (#f=...): one character per question, in order.
      var FR = null; (function () { var m = /^#f=([0-9-]+)$/.exec(location.hash); if (!m || m[1].length !== Q.length) return; FR = {}; Q.forEach(function (q, i) { var s = q.steps[+m[1][i]]; if (m[1][i] !== '-' && s) FR[q.id] = s.id; }); if (!Object.keys(FR).length) FR = null; })();
      function friend() {
        var box = document.getElementById('friend'); if (!FR) { box.hidden = true; return; } box.hidden = false; box.textContent = '';
        var both = Q.filter(function (q) { return FR[q.id] && A[q.id]; }), same = both.filter(function (q) { return FR[q.id] === A[q.id]; });
        box.append(el('p', 'small', 'A friend sent their answers'));
        if (!both.length) { box.append(el('p', 'you-head', 'Answer the questions below to see where the two of you agree.')); return; }
        box.append(el('p', 'you-head', 'You agree on ' + same.length + ' of the ' + both.length + ' question' + (both.length === 1 ? '' : 's') + ' you have both answered.'));
        both.forEach(function (q) { var eq = FR[q.id] === A[q.id], row = el('p', 'you-friend-row' + (eq ? ' same' : '')); row.append(el('span', '', q.plain + ' '), el('b', '', eq ? 'Both: ' + plainOf(q, A[q.id]) : 'You: ' + plainOf(q, A[q.id]) + ' · Them: ' + plainOf(q, FR[q.id]))); if (!eq) { var hear = el('a', 'small', 'Hear both sides →'); hear.href = '/questions/' + q.id; row.append(hear); } box.append(row); });
        var left = Q.filter(function (q) { return FR[q.id] && !A[q.id]; }).length; if (left) box.append(el('p', 'small', left + ' more of their answers will show as you answer.'));
        var back = el('button', 'go', 'Send your answers back, so they see this too →'); back.type = 'button'; back.addEventListener('click', function () { document.getElementById('share-compare').click(); }); box.append(back);
      }
      var LAST = null;
      function share(text, url) {
        var ok = document.getElementById('share-ok'), done = function (m) { ok.textContent = ' ' + m; setTimeout(function () { ok.textContent = ''; }, 2600); };
        if (navigator.share) { navigator.share({ title: 'Svapna', text: text, url: url }).catch(function () {}); return; }
        if (navigator.clipboard) navigator.clipboard.writeText(text + ' ' + url).then(function () { done('Copied. Paste it anywhere.'); }, function () { done('Could not copy.'); }); else done(url);
      }
      document.getElementById('share').addEventListener('click', function () { if (LAST) share('I think most like ' + LAST[0] + ' and least like ' + LAST[1] + ', out of ' + T.length + ' thinkers across four thousand years. Who thinks like you?', 'https://svapnaproject.org/you'); });
      document.getElementById('share-compare').addEventListener('click', function () { var code = Q.map(function (q) { var i = q.steps.findIndex(function (s) { return s.id === A[q.id]; }); return i < 0 ? '-' : i; }).join(''); share('I answered ' + Object.keys(A).length + ' old questions. Answer them and see where we agree.', 'https://svapnaproject.org/you#f=' + code); });
      function paint() {
        friend();
        var n = 0;
        document.querySelectorAll('.you-q').forEach(function (row) { var q = row.dataset.q; if (A[q]) n++; row.querySelectorAll('button').forEach(function (b) { b.setAttribute('aria-pressed', String(A[q] === b.dataset.a)); }); });
        document.getElementById('count').textContent = 'Your answers · ' + n + ' of ' + Q.length;
        stickers(n);
        var res = document.getElementById('result'), need = document.getElementById('need');
        if (n < 3) { document.getElementById('you-bar').hidden = true; res.hidden = true; need.hidden = false; need.textContent = n ? 'Answer ' + (3 - n) + ' more to see your matches.' : 'Answer three questions to see your matches.'; return; }
        var r = rank(); need.hidden = true; res.hidden = false; document.getElementById('share-compare').hidden = false;
        var near = r.slice().sort(function (a, b) { return b.score - a.score || b.shared.length - a.shared.length; }).slice(0, 5);
        var far = r.slice().sort(function (a, b) { return a.score - b.score || b.shared.length - a.shared.length; }).slice(0, 5);
        var N = document.getElementById('near'), F = document.getElementById('far'); N.textContent = ''; F.textContent = '';
        var head = document.getElementById('you-head'); head.textContent = ''; if (near.length) { LAST = [near[0].t.n, far[0].t.n]; head.append((n < 7 ? 'So far, you think most like ' : 'You think most like '), el('b', '', near[0].t.n), ', and least like ', el('b', '', far[0].t.n), '.'); if (n < 7) head.append(el('span', 'small', ' That rests on ' + n + ' answers. It settles as you answer more.')); }
        var bar = document.getElementById('you-bar'); bar.hidden = !near.length; if (near.length) bar.textContent = 'Closest to you: ' + near[0].t.n + ' · furthest: ' + far[0].t.n + '  ↑';
        near.forEach(function (x, i) { var c = card(x, 'near'); if (!i) c.open = true; N.append(c); }); far.forEach(function (x, i) { var c = card(x, 'far'); if (!i) c.open = true; F.append(c); });
      }
      (function kept() {
        var list = []; try { list = JSON.parse(localStorage.getItem('svapna_kept') || '[]') || []; } catch (e) {}
        var sec = document.getElementById('kept'), box = document.getElementById('kept-list'); sec.hidden = !list.length; box.textContent = '';
        list.forEach(function (k) { var row = el('div', 'row you-kept'), a = el('a', 'you-say', '“' + k.text + '”'), side = el('p', 'small', k.name + ' · '), drop = el('button', '', 'Remove'); a.href = k.href; drop.type = 'button';
          drop.addEventListener('click', function () { var now = []; try { now = JSON.parse(localStorage.getItem('svapna_kept') || '[]') || []; } catch (e) {} try { localStorage.setItem('svapna_kept', JSON.stringify(now.filter(function (x) { return x.id !== k.id; }))); } catch (e) {} kept(); });
          side.append(drop); row.append(a, side); box.append(row); });
      })();
      document.getElementById('qs').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-a]'); if (!b) return; var q = b.closest('.you-q').dataset.q;
        if (A[q] === b.dataset.a) delete A[q]; else A[q] = b.dataset.a; save(); paint(); if (Acct.user) Acct.saveAnswer(q, A[q]);
      });
      document.getElementById('clear').addEventListener('click', function () { var had = Object.keys(A); A = {}; save(); paint(); if (Acct.user) had.forEach(function (q) { Acct.saveAnswer(q, null); }); });
      paint();
      // With an account: the device and the account are brought into step, then the page shows the result.
      if (Acct.ready) {
        document.getElementById('acct').hidden = false;
        Acct.start().then(function (u) {
          if (!u) { document.getElementById('acct-out').hidden = false; return; }
          try { A = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) {}
          paint(); document.getElementById('acct-in').hidden = false; document.getElementById('where').textContent = 'Your answers are kept in your account.';
          var name = document.getElementById('name'); name.value = (Acct.profile && Acct.profile.display_name) || '';
          document.getElementById('name-save').addEventListener('click', function () { Acct.saveProfile({ display_name: name.value.trim().slice(0, 40) || null }).then(function (r) { document.getElementById('name-ok').textContent = r && r.error ? ' Could not save.' : ' Saved.'; }); });
          document.getElementById('out').addEventListener('click', function () { Acct.signOut(); });
          document.getElementById('del').addEventListener('click', function () { if (confirm('Delete your account and everything stored in it? This cannot be undone.')) Acct.remove().then(function () { location.href = '/'; }).catch(function () { alert('The account could not be deleted. Please try again.'); }); });
        });
      }
    })();
  </script>
</Read>
