---
import Read from '../../layouts/Read.astro';
import Coffee from '../../components/Coffee.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import { allLetters } from '../../lib/letters.js';
import { articleSchema } from '../../lib/seo.js';

export function getStaticPaths() {
  return allLetters.map(letter => ({ params: { slug: letter.slug }, props: { letter } }));
}
const { letter } = Astro.props;
const idx = allLetters.findIndex(l => l.slug === letter.slug);
// allLetters is newest first: the older letter is next in the array.
const newer = idx > 0 ? allLetters[idx - 1] : null;
const older = idx < allLetters.length - 1 ? allLetters[idx + 1] : null;
const description = (letter.excerpt || letter.title).slice(0, 180);
const path = `/letter/${letter.slug}`;
const articleLd = articleSchema({ url: new URL(path, Astro.site.href).href, headline: letter.title, description, section: 'Letter' });
---
<Read title={`${letter.title} — Letter — Svapna`} description={description} path={path} crumbs={[{ name: 'Letters', path: '/letter' }, { name: letter.title, path }]} jsonLd={articleLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/letter">Letters</a> · {letter.displayDate}</p>
  <h1 class="h-read">{letter.title}</h1>
  {letter.kicker && <p class="lede"><InlineMarkdown text={letter.kicker} /></p>}
  <div class="prose"><MarkdownBody text={letter.body} /></div>
  <nav class="turn">
    {older ? <a href={`/letter/${older.slug}`}><span class="small">Before · {older.displayDate}</span>{older.title}</a> : <span></span>}
    {newer ? <a class="r" href={`/letter/${newer.slug}`}><span class="small">Next · {newer.displayDate}</span>{newer.title}</a> : <span></span>}
  </nav>
  <Coffee />
</Read>
