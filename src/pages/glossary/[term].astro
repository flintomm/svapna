---
import Read from '../../layouts/Read.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import { glossaryTerms, getLesson } from '../../lib/lessons.js';
import { definedTermSchema } from '../../lib/seo.js';
export function getStaticPaths() { return glossaryTerms.map(t => ({ params: { term: t.slug }, props: { entry: t } })); }
const { entry } = Astro.props;
const pad = n => String(parseInt(n, 10)).padStart(2, '0');
// "Module 1, Lesson 2; Module 2, Lesson 4; Lesson 8" → the lessons where the term is taught.
let lastMod = null;
const lessons = (entry.lessonRef || '').split(';').map(s => s.trim()).filter(Boolean).map(ref => {
  const m = ref.match(/Module\s+(\d+)/i), l = ref.match(/Lesson\s+(\d+)/i); if (m) lastMod = m[1];
  const found = l && lastMod ? getLesson(lastMod, l[1]) : null;
  return found ? { title: found.title, href: `/curriculum/module-${pad(lastMod)}/${found.urlSlug}` } : null;
}).filter(Boolean);
const siblings = glossaryTerms.filter(t => t.language === entry.language && t.slug !== entry.slug);
const plain = entry.definition.replace(/[*_]/g, '');
const jsonLd = definedTermSchema({ url: `https://svapnaproject.org/glossary/${entry.slug}`, name: entry.term, description: plain, termCode: entry.slug, language: entry.language, inDefinedTermSet: 'https://svapnaproject.org/glossary' });
---
<Read title={`${entry.term}: meaning in dream practice — Svapna`} description={plain.slice(0, 180)} path={`/glossary/${entry.slug}`}
  crumbs={[{ name: 'Glossary', path: '/glossary' }, { name: entry.term, path: `/glossary/${entry.slug}` }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a> · <a href="/glossary">Glossary</a>{entry.language && <> · {entry.language}</>}</p>
  <h1><em>{entry.term}</em></h1>
  {(entry.aliases.length > 0 || entry.languageTag) && <p class="small" style="margin-top:18px">{[entry.languageTag, ...entry.aliases].filter(Boolean).join(' · ')}</p>}
  <p class="lede def-big"><InlineMarkdown text={entry.definition} /></p>
  {lessons.length > 0 && (
    <section>
      <h2>Where it is explained</h2>
      <div class="qlist small-list">{lessons.map(l => <a href={l.href}>{l.title}<span>Read →</span></a>)}</div>
    </section>
  )}
  {siblings.length > 0 && (
    <section>
      <h2>Other {entry.language || ''} terms</h2>
      <div class="index">{siblings.map(t => <a href={`/glossary/${t.slug}`}>{t.term}</a>)}</div>
    </section>
  )}
</Read>
