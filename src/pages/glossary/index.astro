---
import Read from '../../layouts/Read.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import { glossaryTerms } from '../../lib/lessons.js';
import { definedTermSetSchema } from '../../lib/seo.js';
const groups = [...new Set(glossaryTerms.map(t => t.language || 'Other'))].map(g => ({ name: g, terms: glossaryTerms.filter(t => (t.language || 'Other') === g) }));
const jsonLd = definedTermSetSchema({ url: 'https://svapnaproject.org/glossary', name: 'Svapna glossary of dream and sleep practice', description: 'Sanskrit, Tibetan, Chinese, Greek, Arabic and scientific terms used in the study of dreaming.' });
---
<Read title={`Glossary of dream practice: ${glossaryTerms.length} terms — Svapna`} description={`${glossaryTerms.length} terms from the traditions of dream and sleep practice, in Sanskrit, Pāli, Tibetan, Chinese, Greek, Arabic, French and the language of the sleep laboratory, each defined plainly.`} path="/glossary" crumbs={[{ name: 'Glossary', path: '/glossary' }]} jsonLd={jsonLd}>
  <p class="small crumb"><a href="/">Svapna</a> · <a href="/dream">Dreaming</a> · Glossary</p>
  <h1>The <em>words.</em></h1>
  <p class="lede">{glossaryTerms.length} terms that the traditions of dreaming and the sleep laboratory use for the states of a night, and for what is done in them.</p>
  {groups.map(g => (
    <section>
      <h2>{g.name}</h2>
      <div class="rows">
        {g.terms.map(t => (
          <article class="row term">
            <div><a class="term-name" href={`/glossary/${t.slug}`}>{t.term}</a>{t.aliases.length > 0 && <span class="small"> · {t.aliases.join(' · ')}</span>}</div>
            <p class="term-def"><InlineMarkdown text={t.definition} /></p>
          </article>
        ))}
      </div>
    </section>
  ))}
</Read>
